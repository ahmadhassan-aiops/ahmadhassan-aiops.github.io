---
import BrandIcon from './ui/BrandIcon.astro';
import Icon from './ui/Icon.astro';
import Section from './ui/Section.astro';
import { verdictrx } from '../content/site';
import { logoFor } from '../lib/brand-icons';
import { badge, card, chip, chipLogo, cx, iconTile } from '../lib/ui';
---

<!--
  The flagship product: a feature panel with a terracotta top edge. The outcome and note on the left,
  the stack in three labelled rows on the right, and the four principles in a row underneath. No links.
-->
<Section id="verdictrx" tone="subtle" eyebrow={verdictrx.eyebrow} title={verdictrx.title} intro={verdictrx.intro}>
  <div data-reveal class={cx(card('feature'), 'relative mt-12 overflow-hidden')}>
    <span aria-hidden="true" class="absolute inset-x-0 top-0 h-1 bg-brand-solid"></span>
    <span
      aria-hidden="true"
      class="pointer-events-none absolute -top-32 -right-32 size-[32rem] rounded-full bg-[radial-gradient(closest-side,var(--brand-soft),transparent)]"
    ></span>

    <div class="relative grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <div class="flex flex-wrap gap-2">
          <span class={badge('brand')}>{verdictrx.status}</span>
          <span class={badge('outline')}><Icon name="Stethoscope" />{verdictrx.domain}</span>
        </div>
        <h3 class="mt-5 font-display text-h1 font-semibold text-fg lg:text-h1-lg">{verdictrx.name}</h3>
        <p class="measure mt-4 text-body-lg text-fg-muted">{verdictrx.outcome}</p>
        <p class="mt-6 inline-flex items-center gap-2 text-small text-fg-muted">
          <Icon name="Lock" class="text-brand" />
          {verdictrx.note}
        </p>
      </div>

      <div class="lg:col-span-5">
        <h4 class="text-small font-semibold text-fg">{verdictrx.stackLabel}</h4>
        <dl class="mt-4 space-y-4">
          {
            verdictrx.stack.map((g) => (
              <div class="grid gap-2 sm:grid-cols-[5rem_minmax(0,1fr)] sm:items-start">
                <dt class="pt-1.5 text-caption font-semibold tracking-eyebrow text-fg-subtle uppercase">{g.label}</dt>
                <dd>
                  <ul class="flex flex-wrap gap-2">
                    {g.items.map((t) => {
                      const logo = logoFor(t);
                      return (
                        <li class={chip()}>
                          {logo && <BrandIcon icon={logo} class={chipLogo} />}
                          {t}
                        </li>
                      );
                    })}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <ul class="relative mt-8 grid gap-5 border-t border-line pt-6 sm:mt-10 sm:grid-cols-2 sm:gap-6 sm:pt-8 xl:grid-cols-4">
      {
        verdictrx.principles.map((p) => (
          <li class="flex gap-4">
            <span class={iconTile('brand')}>
              <Icon name={p.icon} strokeWidth={1.75} />
            </span>
            <span>
              <span class="block font-semibold text-fg">{p.label}</span>
              <span class="mt-1 block text-small text-fg-muted">{p.text}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
