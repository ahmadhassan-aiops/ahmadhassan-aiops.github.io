---
import BrandIcon from './ui/BrandIcon.astro';
import Icon from './ui/Icon.astro';
import Section from './ui/Section.astro';
import { verdictrx } from '../content/site';
import { logoFor } from '../lib/brand-icons';
import { badge, cx } from '../lib/ui';
---

<!-- The flagship product: shown as an achievement and ongoing work, without links (as on the platform). -->
<Section id="verdictrx" tone="default" eyebrow={verdictrx.eyebrow} title={verdictrx.title} intro={verdictrx.intro}>
  <div data-reveal class="relative mt-12 overflow-hidden rounded-3xl border border-brand bg-brand-soft p-6 sm:p-8">
    <div class="grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div class="flex flex-wrap gap-2">
          <span class={cx(badge('brand'), 'bg-surface')}><Icon name="Sparkles" />{verdictrx.eyebrow}</span>
          <span class={badge('neutral')}>{verdictrx.status}</span>
          <span class={badge('outline')}><Icon name="Stethoscope" />{verdictrx.domain}</span>
        </div>
        <h3 class="mt-4 text-h1 font-semibold text-fg lg:text-h1-lg">{verdictrx.name}</h3>
        <p class="mt-3 max-w-2xl text-body-lg text-fg-muted">{verdictrx.outcome}</p>
        <p class="mt-5 inline-flex items-center gap-2 text-small text-fg-muted">
          <Icon name="Lock" class="size-4 text-brand" />
          {verdictrx.note}
        </p>
      </div>
      <div class="lg:col-span-5">
        <p class="text-caption font-medium tracking-eyebrow text-fg-muted uppercase">{verdictrx.stackLabel}</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            verdictrx.stack.map((t) => {
              const logo = logoFor(t);
              return (
                <li class="inline-flex h-8 items-center gap-1.5 rounded-full border border-line bg-surface px-3 text-small text-fg-muted">
                  {logo && <BrandIcon icon={logo} class="size-3.5 text-fg-subtle" />}
                  {t}
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
    <ul class="mt-8 grid gap-3 border-t border-brand/20 pt-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        verdictrx.signals.map((s) => (
          <li class="flex items-center gap-3 rounded-2xl border border-line bg-surface p-3">
            <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-brand-solid text-on-brand">
              <Icon name={s.icon} class="size-4.5" strokeWidth={1.75} />
            </span>
            <span class="text-small font-medium text-fg">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
