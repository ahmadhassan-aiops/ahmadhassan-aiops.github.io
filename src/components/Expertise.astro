---
import BrandIcon from './ui/BrandIcon.astro';
import Icon from './ui/Icon.astro';
import Section from './ui/Section.astro';
import { expertise } from '../content/site';
import { logoFor } from '../lib/brand-icons';
import { card, chip, chipLogo, cx, iconTile } from '../lib/ui';

// Chips shown before "+N more": 6 on phones, 8 from sm up. The rest open inline in a <details>.
const MOBILE = 6;
const DESKTOP = 8;
---

<!-- Four groups, each with a one-line description and its most important tools first. -->
<Section id="expertise" eyebrow={expertise.eyebrow} title={expertise.title} intro={expertise.intro}>
  <div class="mt-12 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    {
      expertise.groups.map((g, i) => {
        const rest = g.tools.slice(MOBILE);
        return (
          <div data-reveal style={`--reveal-delay: ${i * 60}ms`} class={cx(card(), 'flex h-full flex-col')}>
            <span class={iconTile('brand')}>
              <Icon name={g.icon} strokeWidth={1.75} />
            </span>
            <h3 class="mt-5 font-display text-h3 font-semibold text-fg">{g.title}</h3>
            <p class="mt-1 text-small text-fg-muted">{g.desc}</p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {g.tools.slice(0, DESKTOP).map((t, j) => {
                const logo = logoFor(t);
                return (
                  <li class={cx(chip(), j >= MOBILE && 'max-sm:hidden')}>
                    {logo && <BrandIcon icon={logo} class={chipLogo} />}
                    {t}
                  </li>
                );
              })}
            </ul>
            {rest.length > 0 && (
              <details class="group mt-2">
                <summary
                  class={cx(
                    chip(),
                    'cursor-pointer list-none border-dashed font-medium text-brand hover:border-brand/50 [&::-webkit-details-marker]:hidden',
                    g.tools.length <= DESKTOP && 'sm:hidden',
                  )}
                >
                  <span class="group-open:hidden sm:hidden">{expertise.moreLabel(g.tools.length - MOBILE)}</span>
                  <span class="group-open:hidden max-sm:hidden">{expertise.moreLabel(g.tools.length - DESKTOP)}</span>
                  <span class="hidden group-open:inline">{expertise.lessLabel}</span>
                </summary>
                <ul class="mt-2 flex flex-wrap gap-2">
                  {rest.map((t, j) => {
                    const logo = logoFor(t);
                    return (
                      <li class={cx(chip(), j + MOBILE < DESKTOP && 'sm:hidden')}>
                        {logo && <BrandIcon icon={logo} class={chipLogo} />}
                        {t}
                      </li>
                    );
                  })}
                </ul>
              </details>
            )}
          </div>
        );
      })
    }
  </div>
</Section>
