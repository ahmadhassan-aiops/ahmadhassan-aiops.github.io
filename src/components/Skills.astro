---
import BrandIcon from './ui/BrandIcon.astro';
import Icon from './ui/Icon.astro';
import Section from './ui/Section.astro';
import { skills } from '../content/site';
import { logoFor } from '../lib/brand-icons';
import { card } from '../lib/ui';
---

<!-- Four expertise groups with tool chips (logos where one exists), as on the platform. -->
<Section id="skills" tone="subtle" eyebrow={skills.eyebrow} title={skills.title} intro={skills.intro}>
  <div class="mt-12 grid gap-4 md:grid-cols-2">
    {
      skills.groups.map((g, i) => (
        <div data-reveal style={`--reveal-delay: ${i * 60}ms`} class={`${card} h-full`}>
          <div class="flex items-center gap-3">
            <span class="grid size-10 place-items-center rounded-xl bg-brand-soft text-brand">
              <Icon name={g.icon} class="size-5" strokeWidth={1.5} />
            </span>
            <h3 class="text-h3 font-semibold text-fg">{g.title}</h3>
          </div>
          <ul class="mt-5 flex flex-wrap gap-2">
            {g.tools.map((t) => {
              const logo = logoFor(t);
              return (
                <li class="inline-flex h-8 items-center gap-1.5 rounded-full border border-line bg-surface px-3 text-small text-fg-muted">
                  {logo && <BrandIcon icon={logo} class="size-3.5 text-fg-subtle" />}
                  {t}
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
