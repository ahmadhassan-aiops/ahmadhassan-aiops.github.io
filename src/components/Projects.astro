---
import BrandIcon from './ui/BrandIcon.astro';
import Icon from './ui/Icon.astro';
import Section from './ui/Section.astro';
import { categories, projects, projectsSection, socials } from '../content/site';
import { badge, button, card, cx, external } from '../lib/ui';

const counts = Object.fromEntries(
  categories.map((c) => [c.id, c.id === 'all' ? projects.length : c.id === 'healthcare' ? projects.filter((p) => p.healthcare).length : projects.filter((p) => p.category === c.id).length]),
);
const labelOf = (id: string) => categories.find((c) => c.id === id)?.label;
---

<!-- Every project as a card (the platform's Featured work card), with filter chips above. -->
<Section id="projects" tone="default" eyebrow={projectsSection.eyebrow} title={projectsSection.title} intro={projectsSection.intro}>
  <div data-reveal class="mt-10 flex flex-wrap gap-2" role="group" aria-label="Filter projects">
    {
      categories.map((c, i) => (
        <button
          type="button"
          data-filter={c.id}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class="inline-flex h-9 items-center gap-2 rounded-full border border-line bg-surface px-3.5 text-small font-medium text-fg-muted transition-colors hover:bg-surface-hover hover:text-fg aria-pressed:border-brand-solid aria-pressed:bg-brand-solid aria-pressed:text-on-brand"
        >
          {c.id === 'healthcare' && <Icon name="HeartPulse" class="size-4" />}
          {c.label}
          <span class="font-mono text-caption tabular-nums opacity-80">{counts[c.id]}</span>
        </button>
      ))
    }
  </div>

  <ul id="project-grid" class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((p) => (
        <li data-category={p.category} data-healthcare={p.healthcare ? '' : undefined}>
          <article class={cx(card, 'flex h-full flex-col transition-[border-color,box-shadow] duration-150 hover:border-brand/40 hover:shadow-md')}>
            <div class="mb-3 flex flex-wrap gap-2">
              <span class={badge('neutral')}>{labelOf(p.category)}</span>
              {p.healthcare && (
                <span class={badge('brand')}>
                  <Icon name="HeartPulse" />
                  Healthcare
                </span>
              )}
              {p.featured && (
                <span class={badge('outline')}>
                  <Icon name="Star" />
                  {projectsSection.featuredBadge}
                </span>
              )}
            </div>
            <h3 class="text-h3 font-semibold text-fg">{p.title}</h3>
            <p class="mt-2 flex-1 text-small text-fg-muted">{p.desc}</p>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {p.tags.slice(0, 3).map((t) => (
                <li class={badge('outline')}>{t}</li>
              ))}
              {p.tags.length > 3 && <li class={badge('neutral')}>+{p.tags.length - 3}</li>}
            </ul>
            <div class="mt-5 flex flex-wrap gap-2 border-t border-line pt-4">
              {p.liveUrl && (
                <a href={p.liveUrl} {...external} class={button('secondary', 'sm')} aria-label={`Live app: ${p.title} (opens in a new tab)`}>
                  <BrandIcon icon="huggingface" />
                  Live app
                  <Icon name="ArrowUpRight" class="text-fg-subtle" />
                </a>
              )}
              <a href={p.githubUrl} {...external} class={button('secondary', 'sm')} aria-label={`Code: ${p.title} (opens in a new tab)`}>
                <BrandIcon icon="github" />
                Code
                <Icon name="ArrowUpRight" class="text-fg-subtle" />
              </a>
            </div>
          </article>
        </li>
      ))
    }
  </ul>
  <p id="project-empty" hidden class="mt-8 text-center text-fg-muted">{projectsSection.empty}</p>

  <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3">
    <a href={socials.portfolioProjects} {...external} class="inline-flex items-center gap-1 font-medium text-brand underline-offset-4 hover:underline">
      {projectsSection.codeLink}
      <Icon name="ArrowUpRight" />
    </a>
    <a href={socials.huggingface} {...external} class="inline-flex items-center gap-1 font-medium text-brand underline-offset-4 hover:underline">
      {projectsSection.appsLink}
      <Icon name="ArrowUpRight" />
    </a>
  </div>
</Section>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const items = [...document.querySelectorAll<HTMLElement>('#project-grid > li')];
  const empty = document.getElementById('project-empty');
  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      for (const b of buttons) b.setAttribute('aria-pressed', String(b === btn));
      let shown = 0;
      for (const li of items) {
        const show = f === 'all' || li.dataset.category === f || (f === 'healthcare' && li.hasAttribute('data-healthcare'));
        li.hidden = !show;
        if (show) shown++;
      }
      if (empty) empty.hidden = shown > 0;
    });
  }
</script>
