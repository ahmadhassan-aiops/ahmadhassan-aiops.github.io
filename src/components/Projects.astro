  { id: 'dl', label: 'Deep Learning', count: projects.filter(p => p.category === 'dl').length },
  { id: 'cv-nlp', label: 'CV & NLP', count: projects.filter(p => p.category === 'cv-nlp').length },
  { id: 'genai', label: 'Generative AI', count: projects.filter(p => p.category === 'genai').length },
