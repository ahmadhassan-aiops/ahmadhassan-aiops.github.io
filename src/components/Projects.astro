---
import BrandIcon from './ui/BrandIcon.astro';
import Icon from './ui/Icon.astro';
import Section from './ui/Section.astro';
import { apps, appsSection, categories, projects, projectsSection, socials } from '../content/site';
import { badge, button, card, chip, cx, external, iconTile, lift } from '../lib/ui';

// Items shown before "Show all"; any filter other than "All" shows every match.
const APPS_INITIAL = 9;
const PROJECTS_INITIAL = 8;

type Item = { category: string; healthcare?: boolean };
const countsFor = (items: Item[]) =>
  Object.fromEntries(
    categories.map((c) => [c.id, c.id === 'all' ? items.length : c.id === 'healthcare' ? items.filter((p) => p.healthcare).length : items.filter((p) => p.category === c.id).length]),
  ) as Record<string, number>;
const appCounts = countsFor(apps);
const projectCounts = countsFor(projects);
const labelOf = (id: string) => categories.find((c) => c.id === id)?.label;

const filterButton =
  'group inline-flex h-11 items-center gap-2 rounded-full border border-line bg-surface pr-2 pl-4 text-small font-medium text-fg-muted transition-colors hover:border-brand/40 hover:text-fg aria-pressed:border-brand-solid aria-pressed:bg-brand-solid aria-pressed:text-on-brand';
const filterCount =
  'grid h-6 min-w-6 place-items-center rounded-full bg-surface-hover px-1.5 font-mono text-caption text-fg-muted tabular-nums group-aria-pressed:bg-on-brand group-aria-pressed:text-brand-700';
const newTab = (label: string, title: string) => `${label}: ${title} (opens in a new tab)`;
---

<!--
  Projects: the live apps first (each card carries the app, its code and its notebook), then every project
  without an app in a compact list. A project is never listed twice. Both lists filter by category and
  show a first batch with "Show all".
-->
<Section id="projects" eyebrow={projectsSection.eyebrow} title={projectsSection.title} intro={projectsSection.intro}>
  <div data-filterable class="mt-14">
    <h3 id="live-apps" class="flex items-center gap-3 font-display text-h3 font-semibold text-fg sm:text-h2">
      <span class="relative flex size-2.5" aria-hidden="true">
        <span class="absolute inline-flex size-full animate-ping rounded-full bg-success opacity-60 motion-reduce:animate-none"></span>
        <span class="relative inline-flex size-2.5 rounded-full bg-success"></span>
      </span>
      {appsSection.title}
      <span class={badge('brand')}>{apps.length}</span>
    </h3>
    <p class="mt-2 max-w-2xl text-small text-fg-muted">{appsSection.intro}</p>

    <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label={appsSection.filterLabel}>
      {
        categories
          .filter((c) => appCounts[c.id] > 0)
          .map((c, i) => (
            <button type="button" data-filter={c.id} aria-pressed={i === 0 ? 'true' : 'false'} class={filterButton}>
              {c.label}
              <span class={filterCount}>{appCounts[c.id]}</span>
            </button>
          ))
      }
    </div>

    <ul data-list class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {
        apps.map((a, i) => (
          <li data-category={a.category} data-healthcare={a.healthcare ? '' : undefined} data-extra={i >= APPS_INITIAL ? '' : undefined}>
            <article class={cx(card(), 'relative flex h-full flex-col overflow-hidden', lift)}>
              <span aria-hidden="true" class={cx('absolute inset-x-0 top-0 h-1', a.healthcare ? 'bg-sage' : 'bg-brand-solid')} />
              <div class="flex items-start gap-4">
                <span class={iconTile(a.healthcare ? 'sage' : 'brand', 'lg')}>
                  <Icon name={a.icon as never} />
                </span>
                <div class="min-w-0 flex-1">
                  <p class="text-caption font-semibold tracking-eyebrow text-fg-subtle uppercase">{labelOf(a.category)}</p>
                  <h4 class="mt-1 font-display text-h3 leading-tight font-semibold text-fg">{a.name ?? a.title}</h4>
                  {a.name && <p class="mt-0.5 text-small font-medium text-fg-muted">{a.title}</p>}
                </div>
              </div>
              {(a.healthcare || a.demo) && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {a.healthcare && (
                    <span class={badge('sage')}>
                      <Icon name="HeartPulse" />
                      {projectsSection.healthcareBadge}
                    </span>
                  )}
                  {a.demo && <span class={badge('dashed')}>{appsSection.demoBadge}</span>}
                </div>
              )}
              <p class="mt-4 flex-1 text-small text-fg-muted">{a.desc}</p>
              <ul class="mt-5 flex flex-wrap gap-1.5">
                {a.tags.map((t) => (
                  <li class={chip()}>{t}</li>
                ))}
              </ul>
              <div class="mt-6 flex flex-wrap gap-2 border-t border-line pt-5">
                <a href={a.liveUrl} {...external} class={button('primary', 'sm')} aria-label={newTab(appsSection.liveLabel, a.name ?? a.title)}>
                  {appsSection.liveLabel}
                  <Icon name="ArrowUpRight" />
                </a>
                <a href={a.codeUrl} {...external} class={button('secondary', 'sm')} aria-label={newTab(appsSection.codeLabel, a.name ?? a.title)}>
                  <BrandIcon icon="github" />
                  {appsSection.codeLabel}
                </a>
                {a.notebookUrl && (
                  <a href={a.notebookUrl} {...external} class={button('secondary', 'sm')} aria-label={newTab(appsSection.notebookLabel, a.name ?? a.title)}>
                    <Icon name="NotebookPen" />
                    {appsSection.notebookLabel}
                  </a>
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ul>
    <p data-empty hidden class="mt-8 text-center text-fg-muted">{appsSection.empty}</p>
    <p data-status class="sr-only" aria-live="polite" data-template={appsSection.showing}></p>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
      <button type="button" data-toggle aria-expanded="false" data-show={appsSection.showAll(apps.length)} data-hide={appsSection.showFewer} class={button('secondary', 'md')}>
        <Icon name="ChevronDown" />
        <span>{appsSection.showAll(apps.length)}</span>
      </button>
      <p class="flex max-w-xl items-start gap-2 text-small text-fg-subtle">
        <Icon name="Info" class="mt-0.5 size-4" />
        {appsSection.wakeNote}
      </p>
    </div>
  </div>

  <div data-filterable class="mt-20">
    <h3 id="all-projects" class="font-display text-h3 font-semibold text-fg sm:text-h2">{projectsSection.allTitle}</h3>
    <p class="mt-2 text-small text-fg-muted">{projectsSection.allIntro}</p>
    <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label={projectsSection.filterLabel}>
      {
        categories
          .filter((c) => projectCounts[c.id] > 0)
          .map((c, i) => (
            <button type="button" data-filter={c.id} aria-pressed={i === 0 ? 'true' : 'false'} class={filterButton}>
              {c.label}
              <span class={filterCount}>{projectCounts[c.id]}</span>
            </button>
          ))
      }
    </div>

    <div class="mt-8 hidden grid-cols-[minmax(0,2.4fr)_minmax(0,1fr)_minmax(0,1.5fr)_8rem] gap-6 border-b border-line-strong pb-3 text-caption font-semibold tracking-eyebrow text-fg-subtle uppercase lg:grid" aria-hidden="true">
      <span>{projectsSection.columns.title}</span>
      <span>{projectsSection.columns.category}</span>
      <span>{projectsSection.columns.tools}</span>
      <span class="text-right">{projectsSection.columns.links}</span>
    </div>
    <ul data-list class="mt-4 grid gap-3 md:grid-cols-2 lg:mt-0 lg:block">
      {
        projects.map((p, i) => (
          <li
            data-category={p.category}
            data-healthcare={p.healthcare ? '' : undefined}
            data-extra={i >= PROJECTS_INITIAL ? '' : undefined}
            class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 rounded-card border border-line bg-surface p-4 sm:flex sm:flex-col sm:items-stretch sm:p-5 lg:grid lg:grid-cols-[minmax(0,2.4fr)_minmax(0,1fr)_minmax(0,1.5fr)_8rem] lg:items-center lg:gap-6 lg:rounded-none lg:border-x-0 lg:border-t-0 lg:bg-transparent lg:px-0 lg:py-5"
          >
            <div class="max-sm:col-span-2">
              <h4 class="font-semibold text-fg">{p.title}</h4>
              <p class="mt-1 text-small text-fg-muted max-sm:hidden lg:line-clamp-1" title={p.desc}>
                {p.desc}
              </p>
            </div>
            <p class="mt-2 flex flex-wrap items-center gap-2 text-small text-fg-muted sm:mt-3 lg:mt-0">
              {labelOf(p.category)}
              {p.healthcare && (
                <span class={badge('sage')}>
                  <Icon name="HeartPulse" />
                  {projectsSection.healthcareBadge}
                </span>
              )}
            </p>
            <ul class="mt-3 flex flex-wrap gap-1.5 max-sm:hidden lg:mt-0">
              {p.tags.slice(0, 3).map((t) => (
                <li class={chip()}>{t}</li>
              ))}
            </ul>
            <div class="mt-2 flex flex-wrap justify-end gap-2 sm:mt-4 sm:justify-start lg:mt-0 lg:justify-end">
              <a href={p.githubUrl} {...external} class={button('secondary', 'sm')} aria-label={newTab(projectsSection.codeLabel, p.title)}>
                <BrandIcon icon="github" />
                {projectsSection.codeLabel}
              </a>
            </div>
          </li>
        ))
      }
    </ul>
    <p data-empty hidden class="mt-8 text-center text-fg-muted">{projectsSection.empty}</p>
    <p data-status class="sr-only" aria-live="polite" data-template={projectsSection.showing}></p>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
      <button type="button" data-toggle aria-expanded="false" data-show={projectsSection.showAll(projects.length)} data-hide={projectsSection.showFewer} class={button('secondary', 'md')}>
        <Icon name="ChevronDown" />
        <span>{projectsSection.showAll(projects.length)}</span>
      </button>
      <a href={socials.portfolioProjects} {...external} class={button('secondary', 'md')}>
        <BrandIcon icon="github" />
        {projectsSection.codeLink}
        <Icon name="ArrowUpRight" />
      </a>
    </div>
  </div>
</Section>

<script>
  // Each block filters by category; "All" shows the first batch until expanded, other filters show every match.
  for (const root of document.querySelectorAll<HTMLElement>('[data-filterable]')) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const list = root.querySelector<HTMLElement>('[data-list]');
    const items = list ? [...list.querySelectorAll<HTMLElement>(':scope > li')] : [];
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    const status = root.querySelector<HTMLElement>('[data-status]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]');
    const heading = root.querySelector<HTMLElement>('h3');
    if (list) {
      list.id = `${heading?.id ?? 'list'}-items`;
      toggle?.setAttribute('aria-controls', list.id);
    }
    const hasExtra = items.some((li) => li.hasAttribute('data-extra'));
    let filter = 'all';
    let expanded = false;

    const render = (announce: boolean) => {
      let shown = 0;
      for (const li of items) {
        const match = filter === 'all' || li.dataset.category === filter || (filter === 'healthcare' && li.hasAttribute('data-healthcare'));
        const show = match && (filter !== 'all' || expanded || !li.hasAttribute('data-extra'));
        li.hidden = !show;
        if (show) shown++;
      }
      if (empty) empty.hidden = shown > 0;
      if (toggle) {
        toggle.hidden = filter !== 'all' || !hasExtra;
        toggle.setAttribute('aria-expanded', String(expanded));
        toggle.querySelector('span')!.textContent = expanded ? toggle.dataset.hide! : toggle.dataset.show!;
        toggle.querySelector('svg')?.classList.toggle('rotate-180', expanded);
      }
      if (announce && status) status.textContent = (status.dataset.template ?? '').replace('{n}', String(shown));
    };

    for (const btn of buttons) {
      btn.addEventListener('click', () => {
        filter = btn.dataset.filter ?? 'all';
        for (const b of buttons) b.setAttribute('aria-pressed', String(b === btn));
        render(true);
      });
    }
    toggle?.addEventListener('click', () => {
      const wasExpanded = expanded;
      expanded = !expanded;
      render(true);
      if (wasExpanded) heading?.scrollIntoView({ block: 'start' });
    });
    render(false);
  }
</script>
