---
import Icon from './ui/Icon.astro';
import Section from './ui/Section.astro';
import { about, journey } from '../content/site';
import { badge, card, cx } from '../lib/ui';
---

<!-- About: the platform's story, quick facts and current focus; then the journey timeline and credentials. -->
<Section id="about" tone="subtle" eyebrow={about.eyebrow} title={about.title}>
  <div class="mt-12 grid gap-10 lg:grid-cols-12 lg:gap-12">
    <div data-reveal class="space-y-5 text-body-lg text-fg-muted lg:col-span-7">
      {about.story.map((p) => <p>{p}</p>)}
    </div>
    <div data-reveal style="--reveal-delay: 60ms" class="space-y-4 lg:col-span-5">
      <div class={card}>
        <ul class="space-y-3">
          {
            about.quickInfo.map((q) => (
              <li class="flex items-center gap-3 text-small text-fg-muted">
                <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-brand-soft text-brand">
                  <Icon name={q.icon} class="size-4" />
                </span>
                {'href' in q ? (
                  <a href={q.href} class="break-all hover:text-fg hover:underline">
                    {q.text}
                  </a>
                ) : (
                  q.text
                )}
              </li>
            ))
          }
        </ul>
      </div>
      <div class={card}>
        <p class="text-caption font-medium tracking-eyebrow text-fg-muted uppercase">{about.focusTitle}</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {about.focus.map((f, i) => <li class={badge(i === 0 ? 'brand' : 'outline')}>{f}</li>)}
        </ul>
      </div>
    </div>
  </div>
</Section>

<Section id="journey" tone="default" align="center" title={journey.title} intro={journey.intro}>
  <ol class="relative mx-auto mt-14 max-w-4xl space-y-6 before:absolute before:inset-y-2 before:left-5 before:w-0.5 before:bg-line-strong lg:space-y-0 lg:before:left-1/2 lg:before:-translate-x-1/2">
    {
      journey.timeline.map((t, i) => {
        const right = i % 2 === 1;
        return (
          <li class="relative grid grid-cols-[2.5rem_minmax(0,1fr)] gap-x-4 lg:grid-cols-[minmax(0,1fr)_3rem_minmax(0,1fr)] lg:gap-x-6 lg:pb-4">
            <span
              aria-hidden="true"
              class={cx(
                'relative z-10 mt-4 grid size-10 place-items-center rounded-full border-2 lg:col-start-2 lg:row-start-1 lg:mx-auto lg:size-12',
                t.future ? 'border-dashed border-brand/50 bg-bg-subtle text-brand' : 'border-brand bg-brand-solid text-on-brand',
              )}
            >
              <Icon name={t.icon} class="size-4.5 lg:size-5" strokeWidth={1.75} />
            </span>
            <div data-reveal style={`--reveal-delay: ${i * 60}ms`} class={cx('lg:row-start-1', right ? 'lg:col-start-3' : 'lg:col-start-1')}>
              <div
                class={cx(
                  'rounded-2xl border p-5 text-left transition-[border-color,box-shadow,translate] duration-150 hover:-translate-y-px hover:shadow-md sm:p-6',
                  t.future ? 'border-dashed border-brand/50 bg-brand-soft' : 'border-line bg-surface shadow-sm hover:border-brand/40',
                )}
              >
                {t.future ? (
                  <span class={cx(badge('brand'), 'bg-surface')}>{journey.nextLabel}</span>
                ) : (
                  <p class="font-mono text-small font-semibold text-brand">{t.year}</p>
                )}
                <h3 class="mt-1.5 text-h3 font-semibold text-fg">{t.title}</h3>
                <p class="mt-2 text-small text-fg-muted">{t.text}</p>
              </div>
            </div>
          </li>
        );
      })
    }
  </ol>

  <h3 class="mt-20 text-center text-h3 font-semibold text-fg">{journey.credentialsTitle}</h3>
  <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      journey.credentials.map((c, i) => (
        <li data-reveal style={`--reveal-delay: ${i * 60}ms`}>
          <div class={cx(card, 'flex h-full flex-col', c.inProgress && 'border-dashed')}>
            <div class="flex items-start justify-between gap-3">
              <span class={cx('grid size-10 place-items-center rounded-xl', c.inProgress ? 'bg-surface-hover text-fg-muted' : 'bg-brand-soft text-brand')}>
                <Icon name={c.icon} class="size-5" strokeWidth={1.5} />
              </span>
              <span class={badge(c.inProgress ? 'dashed' : 'success')}>{c.detail}</span>
            </div>
            <p class="mt-4 font-semibold text-fg">{c.title}</p>
            <p class="mt-1 text-small text-fg-muted">{c.org}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
