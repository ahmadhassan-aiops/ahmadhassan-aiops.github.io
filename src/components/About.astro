---
import Icon from './ui/Icon.astro';
import Section from './ui/Section.astro';
import { about, journey } from '../content/site';
import { badge, card, chip, cx, iconTile } from '../lib/ui';
---

<!-- About: the story with a pull quote; a sticky aside with quick facts, the next goal and the current focus. -->
<Section id="about" eyebrow={about.eyebrow} title={about.title}>
  <div class="mt-12 grid gap-10 lg:grid-cols-12 lg:gap-12 2xl:gap-16">
    <div data-reveal class="lg:col-span-7">
      <div class="measure space-y-5 text-body-lg text-fg-muted">
        {about.story.map((p) => <p>{p}</p>)}
      </div>
      <blockquote class="measure mt-10 border-l-2 border-brand pl-6 font-display text-h2 text-brand italic sm:text-h2-lg">
        {about.pullQuote}
      </blockquote>
    </div>

    <aside data-reveal style="--reveal-delay: 60ms" class="space-y-4 self-start lg:sticky lg:top-24 lg:col-span-5">
      <div class={card()}>
        <h3 class="text-small font-semibold text-fg">{about.factsTitle}</h3>
        <ul class="mt-4 space-y-3">
          {
            about.facts.map((f) => (
              <li class="flex items-center gap-3 text-small text-fg-muted">
                <span class={iconTile('brand')}>
                  <Icon name={f.icon} strokeWidth={1.75} />
                </span>
                {f.text}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex gap-4 rounded-card border border-sage/30 bg-sage-soft p-6">
        <span class={cx(iconTile('sage'), 'bg-surface ring-1 ring-sage/30')}>
          <Icon name="Dna" strokeWidth={1.75} />
        </span>
        <div>
          <span class={cx(badge('sage'), 'bg-surface')}>{about.nextGoal.label}</span>
          <p class="mt-2 text-body text-fg">{about.nextGoal.text}</p>
        </div>
      </div>

      <div class={card()}>
        <h3 class="text-small font-semibold text-fg">{about.focusTitle}</h3>
        <ul class="mt-4 flex flex-wrap gap-2">
          {about.focus.map((f, i) => <li class={chip(i === 0 ? 'brand' : 'default')}>{f}</li>)}
        </ul>
      </div>
    </aside>
  </div>
</Section>

<!--
  Journey: a horizontal timeline at xl (years above the line, cards below), a vertical one with a left
  rail and a year column below xl. The final "next" step is sage and dashed. Then the two credentials.
-->
<Section id="journey" tone="subtle" eyebrow={journey.eyebrow} title={journey.title}>
  <ol class="relative mt-14 xl:grid xl:grid-cols-6 xl:gap-5 xl:before:absolute xl:before:inset-x-0 xl:before:top-10 xl:before:h-px xl:before:bg-line-strong">
    {
      journey.timeline.map((t, i) => (
        <li data-reveal style={`--reveal-delay: ${i * 60}ms`} class="group relative grid grid-cols-[3rem_1.5rem_minmax(0,1fr)] gap-x-3 xl:block">
          <p class={cx('pt-6 text-right font-mono text-small tabular-nums xl:pt-0 xl:text-left', t.future ? 'text-sage' : 'text-fg-subtle')}>{t.year}</p>
          <div class="relative flex justify-center xl:mt-3 xl:block xl:h-4">
            <span aria-hidden="true" class="absolute inset-y-0 w-px bg-line-strong group-first:top-7 group-last:bottom-auto group-last:h-7 xl:hidden"></span>
            <span
              aria-hidden="true"
              class={cx(
                'relative z-10 mt-7 block size-4 rounded-full border-2 xl:mt-0',
                t.future ? 'border-dashed border-sage bg-bg-subtle' : 'border-brand bg-brand',
              )}
            ></span>
          </div>
          <div
            class={cx(
              'mb-5 rounded-card border p-5 xl:mt-5 xl:mb-0 xl:h-[calc(100%-4.25rem)]',
              t.future ? 'border-dashed border-sage/50 bg-sage-soft' : 'border-line bg-surface shadow-sm',
            )}
          >
            {t.future && <span class={cx(badge('sage'), 'mb-2 bg-surface')}>{journey.nextLabel}</span>}
            <h3 class="font-semibold text-fg">{t.title}</h3>
            <p class="mt-2 text-small text-fg-muted">{t.text}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <h3 class="mt-16 font-display text-h3 font-semibold text-fg sm:text-h2">{journey.educationTitle}</h3>
  <ul class="mt-6 grid gap-4 md:grid-cols-2">
    {
      journey.education.map((e, i) => (
        <li data-reveal style={`--reveal-delay: ${i * 60}ms`} class={cx(card('feature'), 'flex flex-col')}>
          <div class="flex items-start justify-between gap-4">
            <span class={iconTile('brand')}>
              <Icon name={e.icon} strokeWidth={1.75} />
            </span>
            <span class="font-mono text-small text-fg-subtle tabular-nums">{e.years}</span>
          </div>
          <h4 class="mt-5 font-display text-h3 font-semibold text-fg">{e.title}</h4>
          <p class="mt-1 text-small text-fg-muted">{e.org}</p>
          <p class="measure mt-3 text-small text-fg-muted">{e.text}</p>
          <span class={cx(badge('brand'), 'mt-5 self-start')}>{e.grade}</span>
        </li>
      ))
    }
  </ul>
</Section>
