---
import Icon from './ui/Icon.astro';
import Section from './ui/Section.astro';
import { about, journey } from '../content/site';
import { badge, card, cx, eyebrow, iconTile, lift } from '../lib/ui';

// One row style for the two aside lists: it warms on hover and its icon tile turns solid.
const row = 'group/row -mx-2 flex items-center gap-3 rounded-control px-2 py-1 transition-colors hover:bg-brand-soft/60 motion-reduce:transition-none';
const rowTile = cx(iconTile('brand', 'sm'), 'transition-colors group-hover/row:bg-brand-solid group-hover/row:text-on-brand motion-reduce:transition-none');
---

<!--
  About: the heading and story on the left; on the right, starting level with the heading, three cards
  (quick facts, the current focus, then the next goal with a slow light sweep) that rise in one after
  another. At lg both columns stretch to the same height: the pull quote sits at the foot of the left
  column and the next-goal card grows to meet it. Rows warm on hover.
-->
<Section id="about" title={about.title} headless>
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-12 2xl:gap-16">
    <div class="flex flex-col lg:col-span-7">
      <div data-reveal>
        <p class={eyebrow}>{about.eyebrow}</p>
        <span aria-hidden="true" class="mt-3 block h-0.5 w-10 rounded-full bg-brand"></span>
        <h2 id="about-title" class="mt-4 font-display text-h2 font-semibold text-balance text-fg sm:text-h2-lg">{about.title}</h2>
      </div>
      <div data-reveal class="measure mt-8 space-y-5 text-body-lg text-fg-muted">
        {about.story.map((p) => <p>{p}</p>)}
      </div>
      <blockquote data-reveal class="measure mt-10 border-l-2 lg:mt-auto lg:pt-10 border-brand pl-6 font-display text-h2 text-brand italic sm:text-h2-lg">
        {about.pullQuote}
      </blockquote>
    </div>

    <aside class="flex flex-col gap-4 lg:col-span-5">
      <div data-reveal style="--reveal-delay: 60ms" class={cx(card(), lift)}>
        <h3 class="text-small font-semibold text-fg">{about.factsTitle}</h3>
        <ul class="mt-3 space-y-1">
          {
            about.facts.map((f) => (
              <li class={cx(row, 'text-small text-fg-muted')}>
                <span class={rowTile}>
                  <Icon name={f.icon} strokeWidth={1.75} />
                </span>
                {f.text}
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal style="--reveal-delay: 140ms" class={cx(card(), lift)}>
        <h3 class="text-small font-semibold text-fg">{about.focusTitle}</h3>
        <ul class="mt-3 space-y-1">
          {
            about.focus.map((f, i) => (
              <li class={cx(row, 'text-small', i === 0 ? 'font-medium text-fg' : 'text-fg-muted')}>
                <span class={i === 0 ? iconTile('solid', 'sm') : rowTile}>
                  <Icon name={f.icon} strokeWidth={1.75} />
                </span>
                {f.text}
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal style="--reveal-delay: 220ms" class="relative flex flex-1 items-center gap-4 overflow-hidden rounded-card border border-sage/30 bg-sage-soft p-6">
        <span aria-hidden="true" class="animate-sheen pointer-events-none absolute inset-y-0 -left-1/2 w-1/2 -skew-x-12 bg-[linear-gradient(to_right,transparent,color-mix(in_oklab,var(--surface)_55%,transparent),transparent)]"></span>
        <span class="relative grid size-10 shrink-0 place-items-center">
          <span aria-hidden="true" class="absolute inset-0 rounded-xl bg-sage/25 motion-safe:animate-[ping_2.6s_cubic-bezier(0,0,0.2,1)_infinite]"></span>
          <span class={cx(iconTile('sage'), 'relative bg-surface ring-1 ring-sage/30')}>
            <Icon name="Dna" strokeWidth={1.75} />
          </span>
        </span>
        <div class="relative">
          <span class={cx(badge('sage'), 'bg-surface')}>{about.nextGoal.label}</span>
          <p class="mt-2 text-body text-fg">{about.nextGoal.text}</p>
        </div>
      </div>
    </aside>
  </div>
</Section>

<!--
  Journey: a horizontal timeline at xl (years above the line, cards below), a vertical one with a left
  rail and a year column below xl. The final "next" step is sage and dashed. Then the two credentials.
  As you scroll, the path lights up one step at a time: the current card lifts and glows, earlier ones
  stay, later ones wait dimmed, and a terracotta line fills the rail up to the current dot. At xl the
  timeline holds in place (sticky) while the page scrolls through the steps. Without JS or with reduced
  motion every card simply shows.
-->
<Section id="journey" tone="subtle" eyebrow={journey.eyebrow} title={journey.title}>
  <div data-journey class="relative mt-14 xl:motion-safe:h-[200vh]">
    <div data-journey-stage class="relative xl:motion-safe:sticky xl:motion-safe:top-[max(6rem,calc(50svh-12rem))]">
      <ol class="relative xl:grid xl:grid-cols-6 xl:gap-5 xl:before:absolute xl:before:inset-x-0 xl:before:top-10 xl:before:h-px xl:before:bg-line-strong">
        {
          journey.timeline.map((t) => (
            <li data-step class="group relative grid grid-cols-[3rem_1.5rem_minmax(0,1fr)] gap-x-3 xl:block">
              <p
                class={cx(
                  'pt-6 text-right font-mono text-small tabular-nums transition-colors duration-500 xl:pt-0 xl:text-left',
                  t.future ? 'text-sage' : 'text-fg-subtle group-data-[state=active]:font-semibold group-data-[state=active]:text-brand',
                )}
              >
                {t.year}
              </p>
              <div class="relative flex justify-center xl:mt-3 xl:block xl:h-4">
                <span aria-hidden="true" class="absolute inset-y-0 w-px bg-line-strong group-first:top-7 group-last:bottom-auto group-last:h-7 xl:hidden"></span>
                <span
                  aria-hidden="true"
                  data-dot
                  class={cx(
                    'relative z-10 mt-7 block size-4 rounded-full border-2 transition-[background-color,scale,box-shadow] duration-500 xl:mt-0',
                    t.future
                      ? 'border-dashed border-sage bg-bg-subtle group-data-[state=active]:scale-125 group-data-[state=active]:shadow-[0_0_0_6px_var(--sage-soft)]'
                      : 'border-brand bg-brand group-data-[state=future]:bg-bg-subtle group-data-[state=active]:scale-125 group-data-[state=active]:shadow-[0_0_0_6px_var(--brand-soft)]',
                  )}
                ></span>
              </div>
              <div
                class={cx(
                  'mb-4 rounded-card border p-5 transition-[opacity,translate,box-shadow,border-color] duration-500 ease-out xl:mt-5 xl:mb-0 xl:h-[calc(100%-4.25rem)]',
                  'group-data-[state=future]:translate-y-3 group-data-[state=future]:opacity-50 group-data-[state=active]:-translate-y-1',
                  t.future
                    ? 'border-dashed border-sage/50 bg-sage-soft group-data-[state=active]:border-sage group-data-[state=active]:shadow-md'
                    : 'border-line bg-surface shadow-sm group-data-[state=active]:border-brand/60 group-data-[state=active]:shadow-brand',
                )}
              >
                {t.future && <span class={cx(badge('sage'), 'mb-2 bg-surface')}>{journey.nextLabel}</span>}
                <h3 class="font-semibold text-fg">{t.title}</h3>
                <p class="mt-2 text-small text-fg-muted">{t.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <span aria-hidden="true" data-rail-fill class="pointer-events-none absolute top-0 left-0 z-[5] hidden rounded-full bg-brand transition-[width,height] duration-500 ease-out"></span>
    </div>
  </div>

  <h3 class="mt-12 font-display text-h3 font-semibold text-fg sm:text-h2">{journey.educationTitle}</h3>
  <ul class="mt-6 grid gap-4 md:grid-cols-2">
    {
      journey.education.map((e, i) => (
        <li data-reveal style={`--reveal-delay: ${i * 60}ms`} class={cx(card(), 'flex gap-4 sm:p-8')}>
          <span class={iconTile('brand')}>
            <Icon name={e.icon} strokeWidth={1.75} />
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-1">
              <h4 class="font-display text-h3 font-semibold text-fg">{e.title}</h4>
              <span class="font-mono text-small text-fg-subtle tabular-nums">{e.years}</span>
            </div>
            <p class="mt-1 text-small text-fg-muted">{e.org}</p>
            <p class="measure mt-2 text-small text-fg-muted">{e.text}</p>
            <span class={cx(badge('brand'), 'mt-4')}>{e.grade}</span>
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<script>
  // The journey lights up step by step as the page scrolls (see the comment above the section).
  const wrap = document.querySelector<HTMLElement>('[data-journey]');
  const stage = wrap?.querySelector<HTMLElement>('[data-journey-stage]');
  const steps = [...(wrap?.querySelectorAll<HTMLElement>('[data-step]') ?? [])];
  const fill = wrap?.querySelector<HTMLElement>('[data-rail-fill]');
  const wide = matchMedia('(min-width: 1280px)');

  if (wrap && stage && fill && steps.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;

    const current = () => {
      if (wide.matches) {
        // Sticky: map the scroll through the tall wrapper onto the steps.
        const r = wrap.getBoundingClientRect();
        if (r.top > innerHeight * 0.6) return -1;
        const range = r.height - stage.offsetHeight;
        const p = range > 0 ? Math.min(1, Math.max(0, (parseFloat(getComputedStyle(stage).top) - r.top) / range)) : 1;
        return Math.min(steps.length - 1, Math.floor(p * steps.length));
      }
      // Stacked: the last card whose top has passed 60% of the viewport.
      let idx = -1;
      steps.forEach((s, i) => {
        if (s.getBoundingClientRect().top < innerHeight * 0.6) idx = i;
      });
      return idx;
    };

    const update = () => {
      ticking = false;
      const idx = current();
      steps.forEach((s, i) => (s.dataset.state = i < idx ? 'past' : i === idx ? 'active' : 'future'));

      // The rail fill runs from the first dot to the current one, along whichever axis the rail uses.
      const centre = (i: number) => {
        const d = steps[i].querySelector<HTMLElement>('[data-dot]')!;
        // Offsets up to the (positioned) stage ignore the active dot's scale and the cards' lift.
        let x = d.offsetWidth / 2;
        let y = d.offsetHeight / 2;
        let el: HTMLElement | null = d;
        while (el && el !== stage) {
          x += el.offsetLeft;
          y += el.offsetTop;
          el = el.offsetParent as HTMLElement | null;
        }
        return { x, y };
      };
      const first = centre(0);
      const to = centre(Math.max(0, idx));
      fill.classList.remove('hidden');
      if (wide.matches) {
        Object.assign(fill.style, { left: '0px', top: `${first.y - 1}px`, height: '2px', width: idx < 0 ? '0px' : `${to.x}px` });
      } else {
        Object.assign(fill.style, { left: `${first.x - 1}px`, top: `${first.y}px`, width: '2px', height: idx < 0 ? '0px' : `${to.y - first.y}px` });
      }
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    update();
  }
</script>
