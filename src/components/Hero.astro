---
import { Image } from 'astro:assets';
import photo from '../assets/ahmad.png';
import Icon from './ui/Icon.astro';
import BrandIcon from './ui/BrandIcon.astro';
import { hero, person, platform, socials, stats } from '../content/site';
import { button, cx, external, iconTile } from '../lib/ui';

type IconName = Parameters<typeof Icon>[0]['name'];

const links: { label: string; href: string; brand?: string; icon?: IconName }[] = [
  { label: 'GitHub', href: socials.github, brand: 'github' },
  { label: 'LinkedIn', href: socials.linkedin, brand: 'linkedin' },
  { label: 'Hugging Face', href: socials.huggingface, brand: 'huggingface' },
  { label: 'WhatsApp', href: socials.whatsappUrl, brand: 'whatsapp' },
  { label: 'Email', href: `mailto:${socials.email}`, icon: 'Mail' },
];

// "1,500+" → 1500 and "+": the numbers count up once when the band scrolls into view.
const counted = stats.map((s) => {
  const m = s.value.match(/^([\d,]+)(.*)$/);
  return { ...s, n: m ? Number(m[1].replace(/,/g, '')) : undefined, suffix: m?.[2] ?? '' };
});
---

<!--
  The hero, light and warm (it follows the theme): a faint dot grid and one static terracotta wash
  behind; the name, roles, statement and CTAs on the left; the photo on a warm frame block with the two
  credentials under it on the right. Then the stats band and the tools marquee.
-->
<section id="top" aria-labelledby="hero-title" class="relative isolate overflow-hidden bg-bg">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="hero-dots absolute inset-0"></div>
    <div class="absolute -top-56 -right-48 size-[52rem] rounded-full bg-[radial-gradient(closest-side,color-mix(in_oklab,var(--brand-soft)_60%,transparent),transparent)]"></div>
  </div>

  <div class="container-wide grid items-center gap-10 pt-10 pb-12 sm:pt-14 sm:pb-16 lg:min-h-[min(calc(100svh-4rem),52rem)] lg:grid-cols-12 lg:gap-10 lg:py-16 2xl:gap-16">
    <div class="lg:col-span-7 2xl:col-span-6">
      <p class="inline-flex flex-wrap items-center gap-x-2 gap-y-1 rounded-full border border-line bg-surface py-1.5 pr-4 pl-3 text-small text-fg-muted shadow-sm">
        <span aria-hidden="true" class="size-2 rounded-full bg-sage"></span>
        {person.availability}
        <span aria-hidden="true" class="max-sm:hidden">·</span>
        <span class="max-sm:hidden">{person.location}</span>
      </p>

      <p class="mt-8 flex items-center gap-3 text-caption font-semibold tracking-eyebrow text-brand uppercase">
        <span aria-hidden="true" class="h-0.5 w-10 rounded-full bg-brand"></span>
        {hero.eyebrow}
      </p>
      <h1 id="hero-title" class="mt-4 font-display text-hero font-semibold text-fg">
        {person.name}<span class="text-brand">.</span>
      </h1>
      <p class="mt-4 text-h3 text-fg-muted">{hero.roles}</p>

      <p class="mt-8 max-w-3xl font-display text-h2 font-medium text-balance text-fg sm:text-h2-lg">{hero.statement}</p>
      <p class="measure-intro mt-4 text-body-lg text-fg-muted">{hero.intro}</p>

      <div class="mt-9 flex flex-wrap items-center gap-3 sm:gap-4">
        <a href="#projects" class={cx(button('primary', 'xl'), 'group')}>
          {hero.primaryCta}
          <Icon name="ArrowDown" class="transition-transform group-hover:translate-y-0.5 motion-reduce:transition-none" />
        </a>
        <!-- The learning platform, as a secondary card-button: icon tile, name and what it is. -->
        <a
          href={platform.url}
          {...external}
          class="group inline-flex h-14 items-center gap-3 rounded-control border border-line-strong bg-surface pr-5 pl-2 transition-colors hover:border-brand/50 hover:bg-surface-hover"
        >
          <span class={iconTile('solid')}><Icon name="GraduationCap" /></span>
          <span class="leading-tight">
            <span class="block text-small font-semibold text-fg">{platform.cta}</span>
            <span class="mt-0.5 block text-caption text-fg-muted">{platform.sub}</span>
          </span>
          <Icon name="ArrowUpRight" class="ml-1 text-brand transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transition-none" />
        </a>
      </div>

      <ul aria-label={hero.socialsLabel} class="mt-8 flex flex-wrap gap-2">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                {...(l.href.startsWith('mailto:') ? {} : external)}
                aria-label={l.label}
                title={l.label}
                class="grid size-11 place-items-center rounded-full border border-line bg-surface text-fg-muted transition-colors hover:border-brand hover:text-brand"
              >
                {l.brand ? <BrandIcon icon={l.brand} class="size-4.5" /> : <Icon name={l.icon!} class="size-4.5" />}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- On phones the photo comes first (max 320px); the credentials under it show from sm up. -->
    <div class="order-first mx-auto w-full max-w-80 sm:max-w-md lg:order-none lg:col-span-5 lg:max-w-[28rem] 2xl:col-start-8">
      <div class="relative">
        <div aria-hidden="true" class="absolute inset-0 translate-x-4 translate-y-4 rounded-feature bg-frame"></div>
        <div class="relative aspect-[4/5] overflow-hidden rounded-feature border border-line bg-surface shadow-md">
          <Image
            src={photo}
            alt={person.photoAlt}
            widths={[320, 448, 640, 896]}
            sizes="(min-width: 1024px) 448px, (min-width: 640px) 448px, 320px"
            loading="eager"
            fetchpriority="high"
            class="size-full object-cover object-top"
          />
        </div>
      </div>
      <ul class="mt-10 hidden gap-3 sm:grid sm:grid-cols-2">
        {
          person.credentials.map((c) => (
            <li class="flex items-center gap-3 rounded-card border border-line bg-surface p-4 shadow-sm">
              <span class={iconTile('brand')}>
                <Icon name={c.icon} strokeWidth={1.75} />
              </span>
              <span class="min-w-0">
                <span class="block text-small leading-tight font-semibold text-fg">{c.title}</span>
                <span class="mt-1 block text-caption text-fg-muted">{c.meta}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container-wide pb-12 lg:pb-16">
    <ul class="grid grid-cols-2 gap-px overflow-hidden rounded-feature border border-line bg-line shadow-sm lg:grid-cols-4">
      {
        counted.map((s) => (
          <li class="bg-surface p-6 sm:p-8">
            <p class="font-mono text-h1 font-semibold text-fg tabular-nums sm:text-h1-lg">
              <span data-count={s.n} data-suffix={s.suffix}>{s.value}</span>
            </p>
            <p class="mt-2 text-small text-fg-muted">{s.label}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="border-y border-line bg-bg-subtle py-5">
    <div class="container-wide flex items-center gap-8">
      <p class="shrink-0 text-caption font-semibold tracking-eyebrow text-fg-subtle uppercase max-md:hidden">{hero.toolsLabel}</p>
      <div data-marquee class="relative flex-1 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_6%,black_94%,transparent)]">
        <p class="sr-only">{hero.toolsLabel}: {hero.tools.map(([, label]) => label).join(', ')}</p>
        <div class="animate-marquee flex w-max" aria-hidden="true">
          {
            [0, 1].map(() => (
              <ul class="flex shrink-0 gap-10 pr-10">
                {hero.tools.map(([icon, label]) => (
                  <li class="flex items-center gap-2.5 text-fg-subtle">
                    <BrandIcon icon={icon} class="size-5" />
                    <span class="text-small font-medium whitespace-nowrap">{label}</span>
                  </li>
                ))}
              </ul>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Stats count up from zero once, the first time the band scrolls into view (skipped for reduced motion).
  const counters = [...document.querySelectorAll<HTMLElement>('[data-count]')];
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && counters.length) {
    const fmt = new Intl.NumberFormat('en-US');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          const el = e.target as HTMLElement;
          const end = Number(el.dataset.count);
          const suffix = el.dataset.suffix ?? '';
          if (!end) continue;
          const start = performance.now();
          const tick = (now: number) => {
            const p = Math.min(1, (now - start) / 1200);
            el.textContent = fmt.format(Math.round(end * (1 - (1 - p) ** 3))) + suffix;
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      },
      { threshold: 0.6 },
    );
    counters.forEach((c) => io.observe(c));
  }
</script>
