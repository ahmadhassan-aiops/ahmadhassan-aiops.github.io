---
import { Image } from 'astro:assets';
import photo from '../assets/ahmad.png';
import Icon from './ui/Icon.astro';
import { hero, person, platform, socials, stats } from '../content/site';
import { badge, button, cx, external, lift } from '../lib/ui';

const ROLE_ICONS = ['BrainCircuit', 'ChartColumn', 'GraduationCap'] as const;
---

<!-- Hero, as on the platform: role chips, headline, intro, CTAs; the photo with two facts; four stat cards. -->
<section id="top" aria-labelledby="hero-title" class="scroll-mt-16 pt-10 pb-16 sm:pt-14 lg:pt-20 lg:pb-24">
  <div class="container-wide grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="order-1 lg:col-span-7">
      <p class="flex flex-wrap gap-2">
        <span class="sr-only">{person.roles.join(', ')}</span>
        {
          person.roles.map((r, i) => (
            <span
              aria-hidden="true"
              class={cx(
                'inline-flex h-8 items-center gap-1.5 rounded-full border px-3 text-small font-medium',
                i === 0 ? 'border-brand/30 bg-brand-soft text-brand' : 'border-line bg-surface text-fg-muted',
              )}
            >
              <Icon name={ROLE_ICONS[i] ?? 'GraduationCap'} class="size-3.5" />
              {r}
            </span>
          ))
        }
      </p>
      <h1 id="hero-title" class="mt-5 text-display font-semibold text-balance text-fg lg:text-display-lg">
        {person.name}
        <span class="mt-2 block text-h1 font-semibold text-fg-muted lg:text-h1-lg">{person.headline}</span>
      </h1>
      <p class="mt-6 max-w-2xl text-body-lg text-fg-muted">{person.intro}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={platform.url} {...external} class={button('primary', 'lg')}>
          <Icon name="GraduationCap" />
          {hero.primaryCta}
          <Icon name="ArrowUpRight" />
        </a>
        <a href="#projects" class={button('secondary', 'lg')}>
          {hero.secondaryCta}
          <Icon name="ArrowRight" />
        </a>
      </div>
      <a
        href={socials.whatsappUrl}
        {...external}
        class="mt-4 inline-flex items-center gap-1 text-small text-fg-muted underline-offset-4 hover:text-fg hover:underline"
      >
        {hero.whatsappLink}
        <Icon name="ArrowRight" class="size-3.5" />
      </a>

      <!-- The learning platform, impossible to miss: a brand card linking to AI with Ahmad. -->
      <a
        href={platform.url}
        {...external}
        class={cx('group mt-8 flex items-start gap-4 rounded-2xl border border-brand/40 bg-brand-soft p-4 sm:p-5', lift, 'hover:border-brand')}
      >
        <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-brand-solid text-on-brand shadow-brand">
          <Icon name="Route" class="size-5" strokeWidth={1.75} />
        </span>
        <span class="min-w-0 flex-1">
          <span class="flex flex-wrap items-center gap-2">
            <span class="font-semibold text-fg">{platform.name}</span>
            <span class={cx(badge('brand'), 'bg-surface')}>{platform.tagline}</span>
          </span>
          <span class="mt-1 block text-small text-fg-muted">{platform.pitch}</span>
          <span class="mt-2 inline-flex items-center gap-1 text-small font-medium text-brand">
            learn.ahmadhassanrx.com
            <Icon name="ArrowUpRight" class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </span>
        </span>
      </a>
    </div>

    <div class="order-2 mx-auto w-70 lg:col-span-5 lg:w-full lg:max-w-110">
      <div class="relative aspect-[4/5] overflow-hidden rounded-3xl border border-line bg-brand-soft shadow-brand">
        <Image
          src={photo}
          alt={person.photoAlt}
          widths={[280, 440, 560, 880]}
          sizes="(min-width: 1024px) 440px, 280px"
          loading="eager"
          fetchpriority="high"
          class="size-full object-cover object-top"
        />
      </div>
      <ul class="mt-4 grid gap-3 lg:grid-cols-2">
        {
          person.photoFacts.map((f) => (
            <li class={cx('flex items-center gap-3 rounded-2xl border border-line bg-surface p-3 shadow-sm', lift)}>
              <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-brand-solid text-on-brand shadow-brand">
                <Icon name={f.icon} class="size-5" strokeWidth={1.75} />
              </span>
              <span class="min-w-0">
                <span class="block text-small leading-tight font-semibold text-fg">{f.title}</span>
                <span class="mt-1 block text-caption text-fg-muted">{f.sub}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container-wide mt-14 lg:mt-20">
    <ul class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {
        stats.map((s) => (
          <li class={cx('relative overflow-hidden rounded-2xl border border-line bg-linear-to-br from-brand-soft/70 via-surface to-surface p-4 shadow-sm sm:p-6', lift)}>
            <span aria-hidden="true" class="grid size-10 place-items-center rounded-xl bg-surface text-brand shadow-sm ring-1 ring-brand/15">
              <Icon name={s.icon} class="size-5" strokeWidth={1.75} />
            </span>
            <p class="mt-4 text-h1 font-semibold text-fg tabular-nums sm:text-h1-lg">{s.value}</p>
            <p class="mt-1 text-small text-fg-muted">{s.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
