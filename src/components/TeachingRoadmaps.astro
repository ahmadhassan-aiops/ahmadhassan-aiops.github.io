---
const domains = [
  {
    id: 'data-science',
    label: 'Data Science',
    icon: '📊',
    color: 'purple',
    tagline: 'From raw data to actionable insights',
    audience: ['Beginners', 'Career Switchers', 'Business Analysts'],
    duration: '3–4 months',
    stages: [
      {
        num: '01',
        title: 'Python & Programming Foundation',
        hours: '~25 hrs',
        topics: ['Python syntax, data types, control flow', 'Functions, OOP basics, modules', 'File I/O and exception handling', 'Virtual environments & project setup'],
      },
      {
        num: '02',
        title: 'Data Manipulation & Visualization',
        hours: '~30 hrs',
        topics: ['NumPy arrays and vectorized ops', 'Pandas DataFrames — cleaning, merging, groupby', 'Matplotlib & Seaborn for storytelling', 'Exploratory Data Analysis (EDA) patterns'],
      },
      {
        num: '03',
        title: 'Statistics & Probability',
        hours: '~20 hrs',
        topics: ['Descriptive statistics (mean, variance, distributions)', 'Inferential statistics & hypothesis testing', 'Correlation, regression foundations', 'A/B testing concepts'],
      },
      {
        num: '04',
        title: 'Real-World Projects & SQL',
        hours: '~20 hrs',
        topics: ['Writing analytical SQL queries', 'End-to-end EDA project pipeline', 'Business insight reporting', 'Power BI / Tableau dashboards'],
      },
    ],
    projects: ['Instacart Customer Behavior Analysis', 'Megaline Telecom Usage Analysis', 'San Francisco Housing Rental Trends', 'Video Game Console Sales Analysis', 'Taxi Company Revenue Analysis'],
  },
  {
    id: 'machine-learning',
    label: 'Machine Learning',
    icon: '🤖',
    color: 'cyan',
    tagline: 'Build predictive models that solve real business problems',
    audience: ['Data Science graduates', 'Working professionals', 'Engineers pivoting to ML'],
    duration: '4–6 months',
    stages: [
      {
        num: '01',
        title: 'ML Foundations & Math',
        hours: '~30 hrs',
        topics: ['Linear algebra essentials (vectors, matrices)', 'Calculus for optimization (gradients)', 'Probability and Bayesian thinking', 'Bias-variance tradeoff, regularization'],
      },
      {
        num: '02',
        title: 'Supervised Learning Algorithms',
        hours: '~40 hrs',
        topics: ['Linear & Logistic Regression', 'SVMs, KNN, Naive Bayes', 'Decision Trees & Random Forests', 'Gradient Boosting, XGBoost, AdaBoost'],
      },
      {
        num: '03',
        title: 'Unsupervised & Model Engineering',
        hours: '~30 hrs',
        topics: ['K-Means, DBSCAN, Hierarchical Clustering', 'PCA & t-SNE for dimensionality reduction', 'Feature engineering & selection pipeline', 'Cross-validation, hyperparameter tuning'],
      },
      {
        num: '04',
        title: 'Production-Ready ML',
        hours: '~25 hrs',
        topics: ['Sklearn Pipelines end-to-end', 'Model evaluation metrics (deep dive)', 'Handling imbalanced datasets', 'Model persistence and serving basics'],
      },
    ],
    projects: ['Bank Customer Churn Prediction', 'Gold Recovery from Mining Process', 'Optimal Oil Well Location (Bootstrapping)', 'Used Car Price Prediction (Rusty Bargain)', 'Stroke Risk Prediction', 'Insurance Benefit Regression', 'Mobile User Classification'],
  },
  {
    id: 'deep-learning',
    label: 'Deep Learning',
    icon: '🧬',
    color: 'green',
    tagline: 'Master neural networks from perceptrons to transformers',
    audience: ['ML practitioners', 'Researchers', 'AI enthusiasts'],
    duration: '3–5 months',
    stages: [
      {
        num: '01',
        title: 'Neural Network Fundamentals',
        hours: '~25 hrs',
        topics: ['Perceptrons and backpropagation', 'Activation functions (ReLU, Sigmoid, Tanh)', 'Optimizers (SGD, Adam, RMSProp)', 'Batch normalization, dropout, weight init'],
      },
      {
        num: '02',
        title: 'Convolutional Neural Networks',
        hours: '~30 hrs',
        topics: ['Convolutions, pooling, padding explained', 'Architectures: LeNet, VGG, ResNet, EfficientNet', 'Transfer learning & fine-tuning', 'Data augmentation strategies'],
      },
      {
        num: '03',
        title: 'Recurrent Architectures',
        hours: '~25 hrs',
        topics: ['RNNs — vanishing gradient problem', 'LSTMs and GRUs in depth', 'Sequence-to-sequence models', 'Attention mechanism intuition'],
      },
      {
        num: '04',
        title: 'Specialized Architectures',
        hours: '~20 hrs',
        topics: ['Autoencoders & Variational Autoencoders', 'Self-Organizing Maps (SOM)', 'Boltzmann Machines & Sparse AEs', 'Architecture selection for real tasks'],
      },
    ],
    projects: ['Customer Churn with Deep Neural Network', 'Computer Vision Classification Project', 'NLP Sequence Modeling'],
  },
  {
    id: 'genai',
    label: 'Generative AI',
    icon: '✨',
    color: 'warn',
    tagline: 'Build with LLMs, fine-tune models, deploy AI products',
    audience: ['ML engineers', 'Product builders', 'Tech entrepreneurs'],
    duration: '2–4 months',
    stages: [
      {
        num: '01',
        title: 'LLM Foundations',
        hours: '~20 hrs',
        topics: ['Transformer architecture deep dive', 'Tokenization, embeddings, attention', 'Prompt engineering patterns', 'Retrieval-Augmented Generation (RAG)'],
      },
      {
        num: '02',
        title: 'Fine-tuning & Adaptation',
        hours: '~25 hrs',
        topics: ['LoRA / QLoRA fine-tuning techniques', 'Hugging Face Trainer API', 'RLHF concepts', 'Dataset preparation for fine-tuning'],
      },
      {
        num: '03',
        title: 'AI Application Development',
        hours: '~25 hrs',
        topics: ['LangChain / LlamaIndex for pipelines', 'Building AI agents and tools', 'Vector databases (Pinecone, ChromaDB)', 'n8n for no-code AI automation'],
      },
      {
        num: '04',
        title: 'Diffusion Models & Deployment',
        hours: '~20 hrs',
        topics: ['Stable Diffusion architecture', 'DreamBooth & LoRA for image models', 'Deploying LLMs (GGUF, vLLM, Ollama)', 'Cost optimization strategies'],
      },
    ],
    projects: ['Bank Complaints Text Summarization (NLP)', 'Complaint Classification with Fine-tuned LLM', 'AI Nutritional Advisor Bot', 'Text-to-Image with Stable Diffusion'],
  },
  {
    id: 'devops',
    label: 'DevOps & MLOps',
    icon: '⚙️',
    color: 'purple',
    tagline: 'Automate, containerize, and scale your AI systems',
    audience: ['Developers', 'ML Engineers', 'System Administrators'],
    duration: '5–8 months',
    stages: [
      {
        num: '01',
        title: 'Linux & Scripting Foundation',
        hours: '~30 hrs',
        topics: ['Linux fundamentals (RHEL)', 'Bash scripting & automation', 'Process management, networking', 'SSH, remote server administration'],
      },
      {
        num: '02',
        title: 'Containerization',
        hours: '~35 hrs',
        topics: ['Docker images, containers, Dockerfile', 'Docker Compose for multi-service apps', 'Container networking & storage', 'Pushing to AWS ECR, Docker Hub'],
      },
      {
        num: '03',
        title: 'Kubernetes Orchestration',
        hours: '~50 hrs',
        topics: ['K8s architecture (Pods, Deployments, Services)', 'Helm charts for packaging', 'StatefulSets, ConfigMaps, Secrets', 'CKAD / CKA exam-level coverage'],
      },
      {
        num: '04',
        title: 'CI/CD & Cloud',
        hours: '~40 hrs',
        topics: ['Jenkins, GitHub Actions, ArgoCD pipelines', 'Infrastructure as Code with Terraform', 'AWS: EC2, S3, ECS, CodeBuild, CodePipeline', 'Monitoring: Prometheus, Grafana, Splunk'],
      },
    ],
    projects: ['End-to-end CI/CD Pipeline (Jenkins + Docker + K8s)', 'Flask App Deployed to AWS ECS', 'Multi-VM Vagrant Automation', 'Python Automation Suite (Jira + Selenium)'],
  },
  {
    id: 'security',
    label: 'Cloud Security',
    icon: '🔐',
    color: 'cyan',
    tagline: 'Defend cloud and AI systems against modern threats',
    audience: ['DevOps engineers', 'IT professionals', 'Security beginners'],
    duration: '4–6 months',
    stages: [
      {
        num: '01',
        title: 'Security Fundamentals',
        hours: '~25 hrs',
        topics: ['CIA Triad, risk management principles', 'Network security & protocols', 'Identity & Access Management (IAM)', 'Cryptography basics & PKI'],
      },
      {
        num: '02',
        title: 'Offensive Security & Testing',
        hours: '~30 hrs',
        topics: ['Penetration testing methodology', 'OWASP Top 10 & web vulnerabilities', 'Network pentesting techniques', 'Vulnerability assessment frameworks'],
      },
      {
        num: '03',
        title: 'Security Operations',
        hours: '~30 hrs',
        topics: ['SIEM platforms (Splunk)', 'Incident response procedures', 'Log analysis and threat hunting', 'SCADA/ICS security (NIST 800-82)'],
      },
      {
        num: '04',
        title: 'Compliance & Cloud Security',
        hours: '~25 hrs',
        topics: ['ISO 27001, PCI-DSS, CIS Controls', 'CISSP / CCSP domain knowledge', 'Zero Trust architecture design', 'Cloud Security Alliance (CSA) CCSK'],
      },
    ],
    projects: ['Vulnerability Assessment Report', 'SIEM Dashboard Configuration', 'Secure Cloud Architecture Design', 'Compliance Gap Analysis'],
  },
];
---

<section id="roadmaps" class="roadmaps-section">
  <div class="section-container">
    <div class="section-header reveal">
      <span class="section-label">Teaching Roadmaps</span>
      <h2 class="section-heading">
        Learn From a <span class="gradient-text">Practitioner</span>
      </h2>
      <p class="section-desc">
        Structured pathways built from 1500+ hours of teaching real students and solving real problems.
        Each roadmap is battle-tested with working professionals who made the leap.
      </p>
    </div>

    <!-- Domain tabs -->
    <div class="roadmap-tabs reveal" role="tablist">
      {domains.map((d, i) => (
        <button
          class={`roadmap-tab ${i === 0 ? 'active' : ''}`}
          data-domain={d.id}
          role="tab"
          aria-selected={i === 0}
          aria-controls={`roadmap-panel-${d.id}`}
        >
          <span class="rtab-icon">{d.icon}</span>
          <span class="rtab-label">{d.label}</span>
        </button>
      ))}
    </div>

    <!-- Domain panels -->
    {domains.map((domain, i) => (
      <div
        class={`roadmap-panel ${i === 0 ? 'active' : ''} color-${domain.color}`}
        id={`roadmap-panel-${domain.id}`}
        role="tabpanel"
      >
        <!-- Panel header -->
        <div class="panel-header">
          <div class="panel-meta">
            <div class="panel-icon">{domain.icon}</div>
            <div>
              <h3 class="panel-title">{domain.label}</h3>
              <p class="panel-tagline">{domain.tagline}</p>
            </div>
          </div>
          <div class="panel-badges">
            <div class="badge-group">
              <span class="meta-label">Duration</span>
              <span class="meta-value">⏱ {domain.duration}</span>
            </div>
            <div class="badge-group">
              <span class="meta-label">Ideal For</span>
              <div class="audience-list">
                {domain.audience.map(a => <span class="audience-tag">{a}</span>)}
              </div>
            </div>
          </div>
        </div>

        <!-- Roadmap stages -->
        <div class="stages-container">
          {domain.stages.map((stage, si) => (
            <div class="stage-item">
              <div class="stage-left">
                <div class="stage-number">{stage.num}</div>
                {si < domain.stages.length - 1 && <div class="stage-connector"></div>}
              </div>
              <div class="stage-content">
                <div class="stage-header">
                  <h4 class="stage-title">{stage.title}</h4>
                  <span class="stage-hours">{stage.hours}</span>
                </div>
                <ul class="stage-topics">
                  {stage.topics.map(t => (
                    <li>
                      <span class="topic-dot"></span>
                      {t}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>

        <!-- Projects built -->
        <div class="panel-projects">
          <h4 class="projects-label">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
            Projects You'll Build
          </h4>
          <div class="project-chips">
            {domain.projects.map(p => <span class="project-chip">{p}</span>)}
          </div>
        </div>

        <!-- CTA -->
        <div class="panel-cta">
          <a href="https://www.superprof.com/tutor-data-science-devops-mlops-cloud-cybersecurity-python-machine-learning-automation-lessons.html" target="_blank" rel="noopener" class="btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
            Book a Session on Superprof
          </a>
          <a href="mailto:ahmad.hds393@gmail.com" class="btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
            </svg>
            Contact Me Directly
          </a>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .roadmaps-section {
    padding: 100px 0;
    position: relative;
    background: var(--bg-primary);
  }

  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .section-heading {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    letter-spacing: -1px;
    margin: 12px 0 16px;
  }

  .section-desc {
    font-size: 16px;
    color: var(--text-muted);
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Tabs */
  .roadmap-tabs {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 36px;
  }

  .roadmap-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .roadmap-tab:hover {
    border-color: rgba(139, 92, 246, 0.3);
    color: var(--text-secondary);
  }

  .roadmap-tab.active {
    background: rgba(139, 92, 246, 0.12);
    border-color: rgba(139, 92, 246, 0.5);
    color: var(--primary-light);
  }

  .rtab-icon { font-size: 16px; }

  /* Panel */
  .roadmap-panel {
    display: none;
  }

  .roadmap-panel.active {
    display: block;
    animation: fade-up 0.4s ease;
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 24px;
    padding: 28px 32px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px 16px 0 0;
    border-bottom: none;
  }

  .panel-meta {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .panel-icon {
    font-size: 40px;
    line-height: 1;
  }

  .panel-title {
    font-size: 22px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .panel-tagline {
    font-size: 14px;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .panel-badges {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-end;
  }

  .badge-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .meta-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .meta-value {
    font-size: 13px;
    font-weight: 500;
    color: var(--success);
  }

  .audience-list {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .audience-tag {
    font-size: 11px;
    padding: 3px 10px;
    border-radius: 100px;
    background: rgba(139, 92, 246, 0.1);
    border: 1px solid rgba(139, 92, 246, 0.25);
    color: var(--primary-light);
    font-weight: 500;
  }

  /* Stages */
  .stages-container {
    padding: 32px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-top: 2px solid;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .color-purple .stages-container { border-top-color: var(--primary); }
  .color-cyan .stages-container { border-top-color: var(--accent); }
  .color-green .stages-container { border-top-color: var(--success); }
  .color-warn .stages-container { border-top-color: var(--warn); }

  .stage-item {
    display: flex;
    gap: 20px;
    padding-bottom: 8px;
  }

  .stage-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .stage-number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
    font-family: 'JetBrains Mono', monospace;
    background: rgba(139, 92, 246, 0.15);
    border: 1px solid rgba(139, 92, 246, 0.3);
    color: var(--primary-light);
    flex-shrink: 0;
  }

  .color-cyan .stage-number {
    background: rgba(34, 211, 238, 0.12);
    border-color: rgba(34, 211, 238, 0.3);
    color: var(--accent);
  }
  .color-green .stage-number {
    background: rgba(52, 211, 153, 0.12);
    border-color: rgba(52, 211, 153, 0.3);
    color: var(--success);
  }
  .color-warn .stage-number {
    background: rgba(251, 191, 36, 0.12);
    border-color: rgba(251, 191, 36, 0.3);
    color: var(--warn);
  }

  .stage-connector {
    width: 2px;
    flex: 1;
    min-height: 32px;
    background: var(--border);
    margin: 4px 0;
    border-radius: 1px;
  }

  .stage-content {
    flex: 1;
    padding-bottom: 32px;
  }

  .stage-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .stage-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .stage-hours {
    font-size: 11px;
    padding: 3px 10px;
    border-radius: 100px;
    background: rgba(52, 211, 153, 0.1);
    border: 1px solid rgba(52, 211, 153, 0.2);
    color: var(--success);
    font-weight: 500;
    white-space: nowrap;
    font-family: 'JetBrains Mono', monospace;
  }

  .stage-topics {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .stage-topics li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .topic-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--primary-light);
    margin-top: 5px;
    flex-shrink: 0;
  }

  .color-cyan .topic-dot { background: var(--accent); }
  .color-green .topic-dot { background: var(--success); }
  .color-warn .topic-dot { background: var(--warn); }

  /* Projects */
  .panel-projects {
    padding: 24px 32px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-top: none;
  }

  .projects-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .project-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .project-chip {
    font-size: 12px;
    padding: 5px 12px;
    border-radius: 8px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .project-chip:hover {
    border-color: rgba(139, 92, 246, 0.4);
    color: var(--primary-light);
  }

  /* CTA */
  .panel-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    padding: 24px 32px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-top: none;
    border-radius: 0 0 16px 16px;
  }

  @media (max-width: 768px) {
    .panel-header {
      padding: 20px;
    }
    .panel-badges {
      align-items: flex-start;
    }
    .badge-group {
      justify-content: flex-start;
    }
    .audience-list {
      justify-content: flex-start;
    }
    .stages-container,
    .panel-projects,
    .panel-cta {
      padding: 20px;
    }
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.roadmap-tab');
  const panels = document.querySelectorAll<HTMLElement>('.roadmap-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const domain = tab.dataset.domain;
      tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
      panels.forEach(p => p.classList.remove('active'));

      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      document.getElementById(`roadmap-panel-${domain}`)?.classList.add('active');
    });
  });
</script>
