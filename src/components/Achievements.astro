---
import Icon from './ui/Icon.astro';
import Section from './ui/Section.astro';
import { achievements } from '../content/site';
import { badge, card, cx, external } from '../lib/ui';
---

<!-- Milestones as cards; in-progress items are dashed and labelled, never shown as earned. -->
<Section id="achievements" tone="default" align="center" eyebrow={achievements.eyebrow} title={achievements.title} intro={achievements.intro}>
  <ul class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {
      achievements.items.map((a, i) => (
        <li data-reveal style={`--reveal-delay: ${(i % 3) * 60}ms`}>
          <div class={cx(card, 'flex h-full flex-col', a.inProgress && 'border-dashed')}>
            <div class="flex items-start justify-between gap-3">
              <span class={cx('grid size-10 place-items-center rounded-xl', a.inProgress ? 'bg-surface-hover text-fg-muted' : 'bg-brand-soft text-brand')}>
                <Icon name={a.icon} class="size-5" strokeWidth={1.5} />
              </span>
              {a.inProgress ? (
                <span class={badge('dashed')}>{achievements.inProgressLabel}</span>
              ) : (
                <span class="font-mono text-small font-semibold text-brand">{a.year}</span>
              )}
            </div>
            <h3 class="mt-4 font-semibold text-fg">{a.title}</h3>
            <p class="mt-1 text-small text-fg-muted">{a.subtitle}</p>
            <p class="mt-3 flex-1 text-small text-fg-muted">{a.desc}</p>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {a.tags.map((t) => (
                <li class={badge('outline')}>{t}</li>
              ))}
            </ul>
            {a.link && (
              <a href={a.link} {...external} class="mt-4 inline-flex items-center gap-1.5 text-small font-medium text-brand underline-offset-4 hover:underline">
                <Icon name="CirclePlay" />
                {achievements.watchLabel}
                <Icon name="ArrowUpRight" />
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</Section>
