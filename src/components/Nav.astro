---
import Icon from './ui/Icon.astro';
import Logo from './ui/Logo.astro';
import ThemeToggle from './ui/ThemeToggle.astro';
import { nav, platform } from '../content/site';
import { button, cx, external } from '../lib/ui';
---

<!-- Sticky 64px nav like the platform's: logo, section links (xl), theme toggle and the AI with Ahmad button. -->
<header id="site-nav" class="sticky top-0 z-40 h-16 border-b border-transparent bg-bg/85 backdrop-blur-md transition-colors">
  <div class="container-wide flex h-full items-center gap-6">
    <a href="#top" aria-label="Ahmad Hassan, back to top" class="shrink-0 rounded-control"><Logo /></a>

    <nav aria-label="Sections" class="hidden flex-1 items-center justify-center gap-1 xl:flex">
      {
        nav.map((l) => (
          <a
            href={l.href}
            data-nav-link
            class="relative px-2.5 py-2 text-small font-medium whitespace-nowrap text-fg-muted transition-colors hover:text-fg data-active:text-fg data-active:after:absolute data-active:after:inset-x-2.5 data-active:after:-bottom-px data-active:after:h-0.5 data-active:after:rounded-full data-active:after:bg-brand"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-2 xl:ml-0">
      <ThemeToggle class="max-xl:hidden" />
      <a href={platform.url} {...external} class={cx(button('primary', 'sm'), 'sm:h-10 sm:px-4')}>
        <Icon name="GraduationCap" />
        {platform.navCta}
        <Icon name="ArrowUpRight" class="hidden sm:block" />
      </a>
      <button type="button" id="menu-open" aria-label="Open menu" aria-controls="mobile-menu" class={cx(button('ghost', 'icon'), 'xl:hidden')}>
        <Icon name="Menu" class="size-5" />
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu: a right-side sheet built on <dialog> (focus trap, Esc and backdrop close for free). -->
<dialog
  id="mobile-menu"
  aria-label="Menu"
  class="fixed inset-y-0 right-0 left-auto m-0 h-full max-h-none w-80 max-w-[85vw] border-l border-line bg-surface p-0 text-fg shadow-md backdrop:bg-black/40"
>
  <div class="flex h-full flex-col">
    <div class="flex h-16 items-center justify-between border-b border-line px-4">
      <span class="text-body font-semibold">Menu</span>
      <button type="button" data-menu-close aria-label="Close menu" class={button('ghost', 'icon')}><Icon name="X" class="size-5" /></button>
    </div>
    <nav aria-label="Sections" class="flex flex-col gap-1 p-3">
      {
        nav.map((l) => (
          <a href={l.href} data-menu-close class="flex h-11 items-center rounded-control px-3 text-body text-fg-muted hover:bg-surface-hover hover:text-fg">
            {l.label}
          </a>
        ))
      }
    </nav>
    <div class="mt-auto space-y-3 border-t border-line p-4">
      <a href={platform.url} {...external} class={cx(button('primary', 'md'), 'w-full')}>
        <Icon name="GraduationCap" />
        {platform.cta}
        <Icon name="ArrowUpRight" />
      </a>
      <div class="flex items-center justify-between text-small text-fg-muted">
        Theme
        <ThemeToggle />
      </div>
    </div>
  </div>
</dialog>

<script>
  const header = document.getElementById('site-nav');
  const menu = document.getElementById('mobile-menu') as HTMLDialogElement | null;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const sections = links.map((l) => document.querySelector<HTMLElement>(l.hash)).filter((s): s is HTMLElement => !!s);

  // Bottom border once scrolled; the active link is the last section whose top passed 35% of the viewport.
  const onScroll = () => {
    const scrolled = window.scrollY > 4;
    header?.classList.toggle('border-line', scrolled);
    header?.classList.toggle('border-transparent', !scrolled);
    const line = window.innerHeight * 0.35;
    const current = sections.filter((s) => s.getBoundingClientRect().top <= line).pop();
    for (const l of links) {
      const on = !!current && l.hash === `#${current.id}`;
      l.toggleAttribute('data-active', on);
      if (on) l.setAttribute('aria-current', 'true');
      else l.removeAttribute('aria-current');
    }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  document.getElementById('menu-open')?.addEventListener('click', () => menu?.showModal());
  menu?.querySelectorAll('[data-menu-close]').forEach((el) => el.addEventListener('click', () => menu.close()));
  menu?.addEventListener('click', (e) => {
    if (e.target === menu) menu.close();
  });
</script>
