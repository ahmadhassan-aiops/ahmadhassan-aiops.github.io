---
import Icon from './ui/Icon.astro';
import Logo from './ui/Logo.astro';
import ThemeToggle from './ui/ThemeToggle.astro';
import { nav, navLabels, platform } from '../content/site';
import { button, cx, external } from '../lib/ui';
---

<!--
  Full-width sticky nav that follows the theme: the mark on the far left, six section links and the
  actions on the far right ("AI with Ahmad" as a secondary button, "Get in touch" as the primary).
-->
<header id="site-nav" class="sticky top-0 z-40 h-16 border-b border-transparent bg-bg/80 backdrop-blur-md transition-colors duration-300">
  <div class="flex h-full items-center gap-4 px-4 sm:px-6 lg:px-10 2xl:px-14">
    <a href="#top" aria-label={navLabels.home} class="shrink-0 rounded-control"><Logo /></a>

    <nav aria-label="Sections" class="ml-auto hidden items-center gap-1 lg:flex">
      {
        nav.map((l) => (
          <a
            href={l.href}
            data-nav-link
            class="rounded-full px-3.5 py-2 text-small font-medium whitespace-nowrap text-fg-muted transition-colors hover:bg-surface-hover hover:text-fg data-active:bg-brand-soft data-active:text-brand"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-2 lg:ml-2 lg:border-l lg:border-line lg:pl-4">
      <ThemeToggle class="max-lg:hidden" />
      <a href={platform.url} {...external} class={cx(button('secondary', 'sm'), 'max-xl:hidden xl:h-10 xl:px-4')}>
        <Icon name="GraduationCap" />
        {platform.navCta}
      </a>
      <a href="#contact" class={cx(button('primary', 'sm'), 'xl:h-10 xl:px-4')}>
        {navLabels.contactCta}
      </a>
      <button type="button" id="menu-open" aria-label={navLabels.openMenu} aria-controls="mobile-menu" aria-expanded="false" class={cx(button('ghost', 'icon'), 'lg:hidden')}>
        <Icon name="Menu" class="size-5" />
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu: a right-side sheet built on <dialog> (focus trap, Esc and backdrop close for free). -->
<dialog
  id="mobile-menu"
  aria-label={navLabels.menu}
  class="fixed inset-y-0 right-0 left-auto m-0 h-full max-h-none w-80 max-w-[85vw] border-l border-line bg-surface-raised p-0 text-fg shadow-md backdrop:bg-black/40"
>
  <div class="flex h-full flex-col">
    <div class="flex h-16 items-center justify-between border-b border-line px-4">
      <span class="text-body font-semibold">{navLabels.menu}</span>
      <button type="button" data-menu-close aria-label={navLabels.closeMenu} class={button('ghost', 'icon')}><Icon name="X" class="size-5" /></button>
    </div>
    <nav aria-label="Sections" class="flex flex-col gap-1 p-3">
      {
        nav.map((l) => (
          <a href={l.href} data-menu-close class="flex h-11 items-center rounded-control px-3 text-body text-fg-muted hover:bg-surface-hover hover:text-fg">
            {l.label}
          </a>
        ))
      }
    </nav>
    <div class="mt-auto space-y-3 border-t border-line p-4">
      <a href="#contact" data-menu-close class={cx(button('primary', 'md'), 'w-full')}>{navLabels.contactCta}</a>
      <a href={platform.url} {...external} class={cx(button('secondary', 'md'), 'w-full')}>
        <Icon name="GraduationCap" />
        {platform.cta}
        <Icon name="ArrowUpRight" />
      </a>
      <div class="flex items-center justify-between text-small text-fg-muted">
        {navLabels.theme}
        <ThemeToggle />
      </div>
    </div>
  </div>
</dialog>

<script>
  const header = document.getElementById('site-nav');
  const menu = document.getElementById('mobile-menu') as HTMLDialogElement | null;
  const opener = document.getElementById('menu-open');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const sections = links.map((l) => document.querySelector<HTMLElement>(l.hash)).filter((s): s is HTMLElement => !!s);

  // Bottom border once scrolled; the active link is the last section whose top passed 35% of the viewport.
  const onScroll = () => {
    const scrolled = window.scrollY > 4;
    header?.classList.toggle('border-line', scrolled);
    header?.classList.toggle('border-transparent', !scrolled);
    const line = window.innerHeight * 0.35;
    const current = sections.filter((s) => s.getBoundingClientRect().top <= line).pop();
    for (const l of links) {
      const on = !!current && l.hash === `#${current.id}`;
      l.toggleAttribute('data-active', on);
      if (on) l.setAttribute('aria-current', 'true');
      else l.removeAttribute('aria-current');
    }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  opener?.addEventListener('click', () => {
    menu?.showModal();
    opener.setAttribute('aria-expanded', 'true');
  });
  menu?.addEventListener('close', () => opener?.setAttribute('aria-expanded', 'false'));
  menu?.querySelectorAll('[data-menu-close]').forEach((el) => el.addEventListener('click', () => menu.close()));
  menu?.addEventListener('click', (e) => {
    if (e.target === menu) menu.close();
  });
</script>
