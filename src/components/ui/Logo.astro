---
/**
 * The platform's monogram (brand-blue square, white "A", two-dot node) with Ahmad's name as the
 * wordmark, so the portfolio and AI with Ahmad share one mark. Replace with the real logo later.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class={`flex items-center gap-2.5 ${className}`}>
  <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true" class="shrink-0">
    <rect width="28" height="28" rx="8" fill="var(--brand-600)"></rect>
    <path d="M8.6 20.5 13.1 7.6h1.8l4.5 12.9h-2.1l-1.1-3.3h-4.4l-1.1 3.3H8.6Zm3.8-5.1h3.2L14 10.3l-1.6 5.1Z" fill="white"></path>
    <circle cx="21.2" cy="7.4" r="1.6" fill="var(--brand-200)"></circle>
    <circle cx="23.4" cy="11.2" r="1.1" fill="var(--brand-300)"></circle>
    <path d="M21.2 7.4 23.4 11.2" stroke="var(--brand-300)" stroke-width="0.8"></path>
  </svg>
  <span class="text-body font-semibold tracking-tight whitespace-nowrap">
    Ahmad <span class="text-brand">Hassan</span>
  </span>
</span>
