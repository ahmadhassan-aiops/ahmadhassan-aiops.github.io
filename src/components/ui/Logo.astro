---
/**
 * The portfolio's own mark (the platform keeps its blue "A" square): an "AH" monogram in a hexagon,
 * the ring of a drug molecule, with two atom nodes that double as network nodes. "From drug molecules
 * to neural networks" in one shape. The wordmark adds the role underneath.
 */
interface Props {
  class?: string;
  /** Hide the role line (e.g. where space is tight). */
  compact?: boolean;
}
const { class: className = '', compact = false } = Astro.props;
const gid = `ah-${Math.random().toString(36).slice(2, 8)}`;
---

<span class={`group/logo flex items-center gap-3 ${className}`}>
  <svg width="34" height="34" viewBox="0 0 32 32" aria-hidden="true" class="shrink-0 transition-transform duration-500 group-hover/logo:rotate-[60deg] motion-reduce:transition-none">
    <defs>
      <linearGradient id={gid} x1="4" y1="2" x2="28" y2="30" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="var(--brand-500)"></stop>
        <stop offset="1" stop-color="var(--brand-800)"></stop>
      </linearGradient>
    </defs>
    <path d="M16 3.2 27 9.6v12.8L16 28.8 5 22.4V9.6Z" fill={`url(#${gid})`} stroke={`url(#${gid})`} stroke-width="2.4" stroke-linejoin="round"></path>
    <g class="transition-transform duration-500 group-hover/logo:-rotate-[60deg] motion-reduce:transition-none" style="transform-origin: 16px 16px" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8.6 21.2 12 11l3.4 10.2M9.8 17.6h4.4"></path>
      <path d="M18.2 11v10.2M23.4 11v10.2M18.2 16.1h5.2"></path>
    </g>
    <circle cx="16" cy="3.2" r="2.3" fill="var(--brand-300)" stroke="var(--bg)" stroke-width="1.2"></circle>
    <circle cx="27" cy="22.4" r="1.9" fill="var(--spark)" stroke="var(--bg)" stroke-width="1.2"></circle>
  </svg>
  <span class="flex flex-col leading-none">
    <span class="font-display text-body font-bold tracking-tight whitespace-nowrap text-fg">Ahmad Hassan</span>
    {!compact && <span class="mt-1 font-mono text-[0.6875rem] tracking-[0.14em] text-fg-subtle uppercase">AI Engineer</span>}
  </span>
</span>
