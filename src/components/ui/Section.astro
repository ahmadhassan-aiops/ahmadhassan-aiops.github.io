---
import { cx, eyebrow as eyebrowClass } from '../../lib/ui';

/**
 * A full-width section: alternating default / subtle backgrounds, 80px → 96px vertical rhythm and
 * one heading pattern everywhere (eyebrow, a short terracotta rule, the H2 in Source Serif 4, an intro at
 * most 60ch). Headings are left-aligned; only Contact centres its own.
 * `split` puts the heading (and the `lead` slot) in a 5-column left panel beside the content at lg.
 * `headless` keeps the section labelled by `${id}-title` but leaves the heading to the caller, for
 * layouts that place it inside their own grid (About).
 */
interface Props {
  id: string;
  tone?: 'default' | 'subtle';
  eyebrow?: string;
  title?: string;
  intro?: string;
  split?: boolean;
  headless?: boolean;
  class?: string;
}
const { id, tone = 'default', eyebrow, title, intro, split = false, headless = false, class: className } = Astro.props;
const titleId = `${id}-title`;
---

<section id={id} aria-labelledby={title ? titleId : undefined} class={cx('scroll-mt-16 py-20 lg:py-24', tone === 'subtle' && 'bg-bg-subtle', className)}>
  <div class={cx('container-wide', split && 'grid gap-10 lg:grid-cols-12 lg:gap-12 2xl:gap-16')}>
    {
      title && !headless && (
        <div data-reveal class={cx(split && 'lg:col-span-5')}>
          {eyebrow && (
            <>
              <p class={eyebrowClass}>{eyebrow}</p>
              <span aria-hidden="true" class="mt-3 block h-0.5 w-10 rounded-full bg-brand" />
            </>
          )}
          <h2 id={titleId} class={cx('font-display text-h2 font-semibold text-balance text-fg sm:text-h2-lg', eyebrow && 'mt-4')}>
            {title}
          </h2>
          {intro && <p class="measure-intro mt-4 text-body-lg text-fg-muted">{intro}</p>}
          <slot name="lead" />
        </div>
      )
    }
    {
      split ? (
        <div class="lg:col-span-7">
          <slot />
        </div>
      ) : (
        <slot />
      )
    }
  </div>
</section>
