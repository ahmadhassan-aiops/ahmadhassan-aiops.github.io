---
import BrandIcon from './ui/BrandIcon.astro';
import Icon from './ui/Icon.astro';
import Section from './ui/Section.astro';
import { huggingface, socials } from '../content/site';
import { badge, button, card, cx, external } from '../lib/ui';
---

<Section id="huggingface" tone="subtle">
  <div data-reveal class="grid items-center gap-10 lg:grid-cols-2">
    <div>
      <p class="text-caption font-medium tracking-eyebrow text-brand uppercase">{huggingface.eyebrow}</p>
      <h2 id="huggingface-title" class="mt-2 text-h2 font-semibold text-balance text-fg sm:text-h2-lg">{huggingface.title}</h2>
      <p class="mt-3 max-w-160 text-body-lg text-fg-muted">{huggingface.intro}</p>
      <a href={socials.huggingface} {...external} class={cx(button('primary', 'lg'), 'mt-8')}>
        <BrandIcon icon="huggingface" />
        {huggingface.cta}
        <Icon name="ArrowUpRight" />
      </a>
    </div>
    <a href={socials.huggingface} {...external} class={cx(card, 'group block transition-[border-color,box-shadow] duration-150 hover:border-brand hover:shadow-md')}>
      <div class="flex items-center gap-4">
        <span class="grid size-12 place-items-center rounded-2xl bg-brand-soft text-brand">
          <BrandIcon icon="huggingface" class="size-6" />
        </span>
        <span>
          <span class="block font-mono font-semibold text-fg">{socials.huggingfaceUser}</span>
          <span class="block text-small text-fg-muted">Hugging Face</span>
        </span>
      </div>
      <div class="mt-5 flex flex-wrap gap-2">
        {huggingface.stats.map((s) => <span class={badge('brand')}>{s}</span>)}
      </div>
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {huggingface.tags.map((t) => <li class={badge('outline')}>{t}</li>)}
      </ul>
      <p class="mt-6 flex items-center justify-between border-t border-line pt-4 text-small font-medium text-brand">
        {huggingface.cardFooter}
        <Icon name="ArrowUpRight" class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </p>
    </a>
  </div>
</Section>
