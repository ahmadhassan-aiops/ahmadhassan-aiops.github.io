---
---

<section id="huggingface" class="hf-section">
  <div class="section-container">
    <div class="hf-inner reveal">
      <!-- Left: text -->
      <div class="hf-text">
        <span class="section-label">Open Source</span>
        <h2 class="hf-heading">
          Models & Experiments on<br />
          <span class="hf-gradient">Hugging Face</span>
        </h2>
        <p class="hf-desc">
          Fine-tuned models, experiment checkpoints, and research artifacts published
          openly — from NLP and Generative AI projects to domain-specific adaptations
          in the clinical and analytical space.
        </p>
        <a
          href="https://huggingface.co/myhuggingface333"
          target="_blank"
          rel="noopener noreferrer"
          class="hf-cta-btn"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"/>
          </svg>
          View Profile → myhuggingface333
        </a>
      </div>

      <!-- Right: visual card -->
      <div class="hf-card glass-card">
        <div class="hf-card-glow"></div>
        <div class="hf-card-header">
          <!-- HuggingFace logo SVG -->
          <svg class="hf-logo" viewBox="0 0 95 88" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M47.2 0C21.2 0 0 19.7 0 44s21.2 44 47.2 44S94.4 68.3 94.4 44 73.2 0 47.2 0z" fill="#FFD21E"/>
            <path d="M23.5 48.5c0 13.1 10.6 23.7 23.7 23.7s23.7-10.6 23.7-23.7H23.5z" fill="#FF6B00"/>
            <path d="M34.5 35c0-2.8 2.2-5 5-5s5 2.2 5 5-2.2 5-5 5-5-2.2-5-5zm20 0c0-2.8 2.2-5 5-5s5 2.2 5 5-2.2 5-5 5-5-2.2-5-5z" fill="#333"/>
            <path d="M16 32s2-8 8-8M78 32s-2-8-8-8" stroke="#333" stroke-width="3" stroke-linecap="round"/>
          </svg>
          <div class="hf-profile-info">
            <span class="hf-username">myhuggingface333</span>
            <span class="hf-platform">Hugging Face</span>
          </div>
        </div>

        <div class="hf-card-body">
          <div class="hf-stat-row">
            <div class="hf-stat">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
              </svg>
              Models & Spaces
            </div>
            <div class="hf-stat">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
              </svg>
              Open Source
            </div>
          </div>

          <div class="hf-tags">
            <span class="hf-tag">NLP</span>
            <span class="hf-tag">Fine-tuning</span>
            <span class="hf-tag">Transformers</span>
            <span class="hf-tag">GenAI</span>
            <span class="hf-tag">Medical AI</span>
          </div>
        </div>

        <a
          href="https://huggingface.co/myhuggingface333"
          target="_blank"
          rel="noopener noreferrer"
          class="hf-card-footer"
        >
          <span>Explore models & spaces</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hf-section {
    padding: 80px 0;
    background: var(--bg-secondary);
    border-top: 1px solid var(--border);
  }

  .hf-inner {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 64px;
    align-items: center;
  }

  /* Text side */
  .hf-heading {
    font-size: clamp(26px, 3.5vw, 40px);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -1px;
    margin: 12px 0 18px;
  }

  .hf-gradient {
    background: linear-gradient(135deg, #FFD21E, #FF6B00);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hf-desc {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 480px;
    margin-bottom: 28px;
  }

  .hf-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(255, 210, 30, 0.15), rgba(255, 107, 0, 0.1));
    border: 1px solid rgba(255, 210, 30, 0.3);
    color: #FFD21E;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .hf-cta-btn:hover {
    background: linear-gradient(135deg, rgba(255, 210, 30, 0.22), rgba(255, 107, 0, 0.15));
    border-color: rgba(255, 210, 30, 0.5);
    transform: translateY(-2px);
  }

  /* Card side */
  .hf-card {
    position: relative;
    overflow: hidden;
    border-color: rgba(255, 210, 30, 0.2);
  }

  .hf-card-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 210, 30, 0.6), rgba(255, 107, 0, 0.4), transparent);
  }

  .hf-card-header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px 24px 20px;
    border-bottom: 1px solid var(--border);
  }

  .hf-logo {
    width: 52px;
    height: 48px;
    flex-shrink: 0;
  }

  .hf-profile-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .hf-username {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
    font-family: 'JetBrains Mono', monospace;
  }

  .hf-platform {
    font-size: 12px;
    color: var(--text-muted);
  }

  .hf-card-body {
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hf-stat-row {
    display: flex;
    gap: 20px;
  }

  .hf-stat {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .hf-stat svg {
    color: #FFD21E;
  }

  .hf-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .hf-tag {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 6px;
    background: rgba(255, 210, 30, 0.08);
    border: 1px solid rgba(255, 210, 30, 0.18);
    color: #e6bc1a;
    font-family: 'JetBrains Mono', monospace;
  }

  .hf-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .hf-card-footer:hover {
    color: #FFD21E;
    background: rgba(255, 210, 30, 0.04);
  }

  @media (max-width: 900px) {
    .hf-inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
