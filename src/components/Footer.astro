---
import BrandIcon from './ui/BrandIcon.astro';
import Icon from './ui/Icon.astro';
import Logo from './ui/Logo.astro';
import ThemeToggle from './ui/ThemeToggle.astro';
import { contact, footer, nav, person, platform, socials } from '../content/site';
import { button, external } from '../lib/ui';

const heading = 'text-caption font-medium tracking-eyebrow text-fg-muted uppercase';
const link = 'inline-flex min-h-8 items-center gap-2 text-small text-fg-muted transition-colors hover:text-fg';
const contactLinks = [
  { href: `mailto:${socials.email}`, label: 'Email', icon: 'mail' },
  { href: socials.whatsappUrl, label: 'WhatsApp', icon: 'whatsapp' },
  { href: socials.linkedin, label: 'LinkedIn', icon: 'linkedin' },
  { href: socials.github, label: 'GitHub', icon: 'github' },
  { href: socials.huggingface, label: 'Hugging Face', icon: 'huggingface' },
  { href: socials.superprof, label: 'Superprof profile', icon: 'superprof' },
];
---

<!-- The platform's closing brand band, as the contact call to action. -->
<section id="contact" aria-labelledby="contact-title" class="scroll-mt-16 pb-20 lg:pb-28">
  <div class="container-wide">
    <div data-reveal class="rounded-3xl bg-brand-solid px-6 py-12 text-center shadow-brand sm:px-12 lg:py-16">
      <p class="text-caption font-medium tracking-eyebrow text-on-brand/80 uppercase">{contact.eyebrow}</p>
      <h2 id="contact-title" class="mt-2 text-h2 font-semibold text-balance text-on-brand sm:text-h2-lg">{contact.title}</h2>
      <p class="mx-auto mt-3 max-w-160 text-body-lg text-on-brand/85">{contact.text}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={`mailto:${socials.email}`} class={button('inverse', 'lg')}>
          <Icon name="Mail" />
          {contact.email}
        </a>
        <a href={socials.whatsappUrl} {...external} class={button('inverse-outline', 'lg')}>
          <BrandIcon icon="whatsapp" />
          {contact.whatsapp}
        </a>
        <a href={platform.url} {...external} class={button('inverse-outline', 'lg')}>
          <Icon name="GraduationCap" />
          {platform.cta}
          <Icon name="ArrowUpRight" />
        </a>
      </div>
    </div>
  </div>
</section>

<footer class="mt-auto border-t border-line bg-bg-subtle">
  <div class="container-wide grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <Logo />
      <p class="mt-4 max-w-xs text-small text-fg-muted">{footer.tagline}</p>
      <p class="mt-4 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-caption font-medium text-fg-muted">
        <span aria-hidden="true" class="size-2 rounded-full bg-success"></span>
        {person.availability}
      </p>
    </div>

    <nav aria-label="Portfolio">
      <h2 class={heading}>{footer.portfolioTitle}</h2>
      <ul class="mt-3 space-y-1">
        {nav.filter((l) => l.href !== '#contact').map((l) => <li><a href={l.href} class={link}>{l.label}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Learn">
      <h2 class={heading}>{footer.learnTitle}</h2>
      <ul class="mt-3 space-y-1">
        {
          footer.learn.map((l) => (
            <li>
              <a href={l.href} {...external} class={link}>
                {l.label} <Icon name="ArrowUpRight" class="size-3.5" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Contact">
      <h2 class={heading}>{footer.contactTitle}</h2>
      <ul class="mt-3 space-y-1">
        {
          contactLinks.map((l) => (
            <li>
              <a href={l.href} {...(l.href.startsWith('mailto:') ? {} : external)} class={link}>
                {l.icon === 'mail' ? <Icon name="Mail" /> : l.icon === 'superprof' ? <Icon name="Presentation" /> : <BrandIcon icon={l.icon} />}
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="border-t border-line">
    <div class="container-wide flex items-center justify-between gap-4 py-4 text-small text-fg-muted">
      <p>© {new Date().getFullYear()} {person.name} · {person.location}</p>
      <ThemeToggle />
    </div>
  </div>
</footer>
