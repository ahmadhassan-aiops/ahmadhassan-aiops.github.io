---
import BrandIcon from './ui/BrandIcon.astro';
import Icon from './ui/Icon.astro';
import Logo from './ui/Logo.astro';
import ThemeToggle from './ui/ThemeToggle.astro';
import { contact, footer, nav, person, platform, socials } from '../content/site';
import { button, external } from '../lib/ui';

const heading = 'text-caption font-semibold tracking-eyebrow text-fg-muted uppercase';
const link = 'inline-flex min-h-11 items-center gap-2 text-small text-fg-muted transition-colors hover:text-fg lg:min-h-8';
const contactHref: Record<string, string> = {
  email: `mailto:${socials.email}`,
  whatsapp: socials.whatsappUrl,
  linkedin: socials.linkedin,
  github: socials.github,
  huggingface: socials.huggingface,
  superprof: socials.superprof,
};
---

<!-- Contact: a terracotta band with a faint paper grain, centred; then the four-column footer. -->
<section id="contact" aria-labelledby="contact-title" class="scroll-mt-16 py-20 lg:py-24">
  <div class="container-wide">
    <div data-reveal class="relative overflow-hidden rounded-feature bg-brand-solid px-6 py-10 text-center text-on-brand shadow-brand sm:px-12 sm:py-12 lg:py-16">
      <span aria-hidden="true" class="grain pointer-events-none absolute inset-0 opacity-10"></span>
      <div class="relative">
        <p class="text-caption font-semibold tracking-eyebrow uppercase">{contact.eyebrow}</p>
        <span aria-hidden="true" class="mx-auto mt-3 block h-0.5 w-10 rounded-full bg-on-brand"></span>
        <h2 id="contact-title" class="mt-4 font-display text-h2 font-semibold text-balance sm:text-h2-lg">{contact.title}</h2>
        <p class="measure-intro mx-auto mt-4 text-body-lg">{contact.text}</p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <a href={`mailto:${socials.email}`} class={button('inverse', 'lg')}>
            <Icon name="Mail" />
            {contact.email}
          </a>
          <a href={socials.whatsappUrl} {...external} class={button('inverse-outline', 'lg')}>
            <BrandIcon icon="whatsapp" />
            {contact.whatsapp}
          </a>
          <a href={platform.url} {...external} class={button('inverse-outline', 'lg')}>
            <Icon name="GraduationCap" />
            {platform.cta}
            <Icon name="ArrowUpRight" />
          </a>
        </div>
        <p class="mt-6 font-mono text-small select-all">{socials.email}</p>
      </div>
    </div>
  </div>
</section>

<footer class="mt-auto border-t border-line bg-bg-subtle">
  <div class="container-wide grid grid-cols-2 gap-x-6 gap-y-8 py-12 lg:grid-cols-4 lg:gap-y-10 lg:py-14">
    <div class="col-span-2 lg:col-span-1">
      <Logo />
      <p class="mt-4 max-w-xs text-small text-fg-muted">{footer.tagline}</p>
      <p class="mt-4 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-caption font-medium text-fg-muted">
        <span aria-hidden="true" class="size-2 rounded-full bg-sage"></span>
        {person.availability}
      </p>
    </div>

    <nav aria-label={footer.portfolioTitle}>
      <h2 class={heading}>{footer.portfolioTitle}</h2>
      <ul class="mt-2 lg:mt-3 lg:space-y-1">
        {nav.map((l) => <li><a href={l.href} class={link}>{l.label}</a></li>)}
      </ul>
    </nav>

    <nav aria-label={footer.learnTitle}>
      <h2 class={heading}>{footer.learnTitle}</h2>
      <ul class="mt-2 lg:mt-3 lg:space-y-1">
        {
          footer.learn.map((l) => (
            <li>
              <a href={l.href} {...external} class={link}>
                {l.label} <Icon name="ArrowUpRight" class="size-3.5" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label={footer.contactTitle} class="col-span-2 sm:col-span-1">
      <h2 class={heading}>{footer.contactTitle}</h2>
      <ul class="mt-2 lg:mt-3 lg:space-y-1">
        {
          footer.contact.map((l) => (
            <li>
              <a href={contactHref[l.key]} {...(l.key === 'email' ? {} : external)} class={link}>
                {l.key === 'email' ? <Icon name="Mail" /> : l.key === 'superprof' ? <Icon name="Presentation" /> : <BrandIcon icon={l.key} />}
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="border-t border-line">
    <div class="container-wide flex flex-wrap items-center justify-between gap-4 py-4 text-small text-fg-muted">
      <p>© {new Date().getFullYear()} {person.name} · {person.location}</p>
      <div class="flex items-center gap-3">
        <span class="text-fg-subtle">{footer.builtWith}</span>
        <ThemeToggle />
      </div>
    </div>
  </div>
</footer>
