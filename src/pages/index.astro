---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import VerdictRx from '../components/VerdictRx.astro';
import Roadmaps from '../components/Roadmaps.astro';
import Projects from '../components/Projects.astro';
import HuggingFace from '../components/HuggingFace.astro';
import Achievements from '../components/Achievements.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Nav />
  <main id="main" tabindex="-1" class="flex-1 outline-none">
    <Hero />
    <About />
    <Skills />
    <VerdictRx />
    <Roadmaps />
    <Projects />
    <HuggingFace />
    <Achievements />
  </main>
  <Footer />
</Layout>
