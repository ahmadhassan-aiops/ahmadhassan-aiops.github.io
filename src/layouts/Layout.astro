---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import photo from '../assets/ahmad.png';
import { meta, navLabels } from '../content/site';
// Fraunces (headings), latin only, with every axis so SOFT and optical sizing work.
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url';
import frauncesItalicUrl from '@fontsource-variable/fraunces/files/fraunces-latin-full-italic.woff2?url';

interface Props {
  title?: string;
  description?: string;
}
const { title = meta.title, description = meta.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Social preview uses the same photo as the hero, resized to a light JPEG.
const ogImage = await getImage({ src: photo, width: 800, format: 'jpg' });
---

<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <meta name="theme-color" content="#fbf7f1" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#17120f" />
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <style
      is:inline
      set:html={`@font-face{font-family:"Fraunces Variable";font-style:normal;font-display:swap;font-weight:100 900;src:url(${frauncesUrl}) format("woff2-variations")}@font-face{font-family:"Fraunces Variable";font-style:italic;font-display:swap;font-weight:100 900;src:url(${frauncesItalicUrl}) format("woff2-variations")}`}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Light by default, like the platform; the saved choice is applied before paint so there is no flash. -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
      } catch {}
    </script>
    <noscript><style>[data-reveal]{opacity:1!important;translate:none!important}</style></noscript>
  </head>
  <body class="flex min-h-full flex-col">
    <a
      href="#main"
      class="sr-only rounded-control bg-brand-solid px-4 py-2 text-small font-medium text-on-brand focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      {navLabels.skip}
    </a>
    <slot />
    <script>
      // Section reveal: flip data-revealed once an element scrolls into view (styles in global.css).
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            (e.target as HTMLElement).dataset.revealed = '';
            io.unobserve(e.target);
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Theme toggles (nav, menu and footer): flip the class and remember the choice.
      document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) =>
        btn.addEventListener('click', () => {
          const dark = document.documentElement.classList.toggle('dark');
          try {
            localStorage.setItem('theme', dark ? 'dark' : 'light');
          } catch {}
        }),
      );
    </script>
  </body>
</html>
